        <div class="field__item">

<div  class="paragraph paragraph--type--card paragraph--view-mode--default">
          
  <div class="field field--name-field-image field--type-entity-reference field--label-hidden field__items">
        <div class="field__item">
<article >
  
        <img loading="lazy" src="/sites/default/files/styles/crop_card/public/2023-06/Point-in-Time-Count-card.png.webp?itok=z410lKAj" width="350" height="200" alt="decoration" />



  </article>
