			function whichHeader() {
				var screenWidth = document.documentElement.clientWidth,
				header_img;
				if (screenWidth <= 767) {
					header_img = 'https://thecontributor.org/wp-content/uploads/2023/06/mobile-logo-with-banner.png';
				} else if (screenWidth > 767 && screenWidth <= 979) {
					header_img = '/wp-content/uploads/2023/01/Contributor-Logo-980-x-180.png';
				} else {
					header_img = '/wp-content/uploads/2023/05/new-banner-v2.png';
