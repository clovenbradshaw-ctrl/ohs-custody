IZBQPG4cU1s3yVE25fWKxSWkDA=/109x0:1729x1080/320x213/2026/08/18/1787083173388.jpeg","width":320,"height":213},{"url":"https://images.axios.com/8AufFcC0LUcSj2qFajzTeGZDw1M=/109x0:1729x1080/640x426/2026/08/18/1787083173388.jpeg","width":640,"height":426},{"url":"https://images.axios.com/50y7q-D7b1haSSIGeIRiyLWBtcs=/109x0:1729x1080/768x512/2026/08/18/1787083173388.jpeg","width":768,"height":512}]},"4x3":{"url":"https://images.axios.com/EFGOJeONQXkinodREi4hd8EwpvQ=/247x0:1687x1080/1440x1080/2026/08/18/1787083173388.jpeg","sizes":[{"url":"https://images.axios.com/0FYbrXwmB5FRWTiS7AiVFjozY_w=/247x0:1687x1080/1024x768/2026/08/18/1787083173388.jpeg","width":1024,"height":768},{"url":"https://images.axios.com/lGOkGr6fJcI1jKguxE03tyOw9h4=/247x0:1687x1080/1366x1024/2026/08/18/1787083173388.jpeg","width":1366,"height":1024},{"url":"https://images.axios.com/m2oHL2F0825V-7m91TPLKKczGqY=/247x0:1687x1080/1600x1200/2026/08/18/1787083173388.jpeg","width":1600,"height":1200},{"url":"https://images.axios.com/A-CFt8YrYmScUZ2FftBjtGXrv4U=/247x0:1687x1080/1920x1440/2026/08/18/1787083173388.jpeg","width":1920,"height":1440},{"url":"https://images.axios.com/Xa46LIqqNxuQgd9HIvymgbQNXdg=/247x0:1687x1080/320x240/2026/08/18/1787083173388.jpeg","width":320,"height":240},{"url":"https://images.axios.com/YoFNopcg1YIcOJQX_D6F-DWl5gc=/247x0:1687x1080/640x480/2026/08/18/1787083173388.jpeg","width":640,"height":480},{"url":"https://images.axios.com/rLhBqjaJAvPVy4F-sfPJvCbmIt4=/247x0:1687x1080/768x576/2026/08/18/1787083173388.jpeg","width":768,"height":576}]},"16x9":{"url":"https://images.axios.com/GCmoClmv8zhgxhgXKcqih5P5RRM=/0x0:1920x1080/1920x1080/2026/08/18/1787083173388.jpeg","sizes":[{"url":"https://images.axios.com/4vadzdPS1wUSxJmFGsaJ9crHQDg=/0x0:1920x1080/1024x576/2026/08/18/1787083173388.jpeg","width":1024,"height":576},{"url":"https://images.axios.com/j6HLFIySDk5TevZ0rtt6pMPncho=/0x0:1920x1080/1366x768/2026/08/18/1787083173388.jpeg","width":1366,"height":768},{"url":"https://images.axios.com/do-sG_2z6asRUCYsPUjX41L5huQ=/0x0:1920x1080/1600x900/2026/08/18/1787083173388.jpeg","width":1600,"height":900},{"url":"https://images.axios.com/GCmoClmv8zhgxhgXKcqih5P5RRM=/0x0:1920x1080/1920x1080/2026/08/18/1787083173388.jpeg","width":1920,"height":1080},{"url":"https://images.axios.com/o9WH0K6M7krtIm3mPSkQgG9wmUI=/0x0:1920x1080/320x180/2026/08/18/1787083173388.jpeg","width":320,"height":180},{"url":"https://images.axios.com/YHngFdr_6KetVGVcFjDhdSxcZwA=/0x0:1920x1080/640x360/2026/08/18/1787083173388.jpeg","width":640,"height":360},{"url":"https://images.axios.com/siF3WW1gOPPZWPfq0UsP4TgwwvM=/0x0:1920x1080/768x432/2026/08/18/1787083173388.jpeg","width":768,"height":432}]}},"embed":false,"source":"","alt_text":"Kristin Wilson's portrait","image_id":"7d8714d9-314c-4dda-b53a-a00839650c5c","orig_width":1920,"is_animated":false,"orig_height":1080,"blurred_data":"","caption_json":{"type":"doc","content":[{"type":"figcaption","content":[{"text":"Kristin Wilson. Photo: courtesy of Metro","type":"text"}]}]},"orig_filename":"FeaturedImage (15).jpeg"},"text":"Kristin Wilson. Photo: courtesy of Metro","type":"image","depth":0,"entityRanges":[],"inlineStyleRanges":[]}],"entityMap":{}},"social_image":null,"social_graphic":null,"og_headline":"","og_description":"Kristin Wilson, aide to the last two Nashville mayors, is resigning from her job.","rubric":null,"template":null,"promotion":null,"wordcount":0,"read_more_wordcount":0,"before_read_more_wordcount":0,"keep_reading_mins":"\u003c1","is_breaking_news":false,"topics":[{"id":"c4f7380b-c716-400e-a2cc-0259369cfd8e","slug":"news","name":"News","page_title":"News","description":"","is_local":true,"nav_position":40,"show_in_nav":false,"show_in_eden":true,"is_auto_applied":false},{"id":"254cd341-addc-47b9-81f5-5e20b0094c11","slug":"politics","name":"Politics","page_title":"Politics","description":"","is_local":true,"nav_position":10,"show_in_nav":false,"show_in_eden":true,"is_auto_applied":false}],"subtopics":[],"audience":{"id":"11a79f3a-8967-42ee-8505-4a23b11afec5","name":"Nashville","local_logo_name":null,"slug":"nashville","audience_type":"local","timezone":"America/Chicago","default_paywall_status":"hidden"},"cross_promote_to":[],"include_on_site":true,"include_in_latest_stories":false,"homepage_unit_title":"","needs_redirect":false,"is_paywalled":false,"is_evergreen":false,"is_live":false,"is_sponsored":false,"dataviz_config":null,"featured_date":null,"bodyHtml":{"beforeKeepReading":"\u003cp\u003eKristin Wilson, one of Metro government\u0026#x27;s most consequential officials, is leaving Mayor Freddie O\u0026#x27;Connell\u0026#x27;s office.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eWhy it matters: \u003c/strong\u003eWilson serves as the city\u0026#x27;s chief of operations and performance, a behind-the-scenes role that is out of the public eye but at the center of the most pressing Metro issues.\u003c/p\u003e","hasKeepReading":true,"keepReadingData":{"readTime":"","buttonText":"Go deeper","showWordCount":true,"wordCount":144},"afterKeepReading":"\u003cp\u003e\u003cstrong\u003eZoom in: \u003c/strong\u003eWilson worked with Metro for seven years, navigating the pandemic, the 2020 tornado, the Christmas bombing and school shootings.\u003c/p\u003e\u003cul\u003e\u003cli\u003eHer job is to make sure the city government operates efficiently. She served as one of the top aides to both O\u0026#x27;Connell and his predecessor, Mayor John Cooper.\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cstrong\u003eZoom out: \u003c/strong\u003eWilson is the fourth top aide to leave the mayor\u0026#x27;s office since July 2025. Other departures include former chief of staff \u003ca class=\"gtmContentClick\" data-vars-link-text=\"Marjorie Pomeroy-Wallace\" data-vars-click-url=\"https://www.axios.com/local/nashville/2025/07/08/mayor-oconnell-new-chief-of-staff-marjorie-pomeroy-wallace-moves-to-new-role\" data-vars-content-id=\"dd404bc5-fcbc-48f2-ba93-fce79e538607\" data-vars-headline=\"Mayoral aide Kristin Wilson resigns from top Metro post\" data-vars-event-category=\"story\" data-vars-sub-category=\"story\" data-vars-item=\"in_content_link\" href=\"https://www.axios.com/local/nashville/2025/07/08/mayor-oconnell-new-chief-of-staff-marjorie-pomeroy-wallace-moves-to-new-role\" target=\"_self\"\u003eMarjorie Pomeroy-Wallace\u003c/a\u003e, development chief \u003ca class=\"gtmContentClick\" data-vars-link-text=\"Bob Mendes\" data-vars-click-url=\"https://www.axios.com/local/nashville/2025/09/24/top-oconnell-aide-bob-mendes-to-leave-the-mayors-office\" data-vars-content-id=\"dd404bc5-fcbc-48f2-ba93-fce79e538607\" data-vars-headline=\"Mayoral aide Kristin Wilson resigns from top Metro post\" data-vars-event-category=\"story\" data-vars-sub-category=\"story\" data-vars-item=\"in_content_link\" href=\"https://www.axios.com/local/nashville/2025/09/24/top-oconnell-aide-bob-mendes-to-leave-the-mayors-office\" target=\"_self\"\u003eBob Mendes\u003c/a\u003e and legal director \u003ca class=\"gtmContentClick\" data-vars-link-text=\"Wally Dietz\" data-vars-click-url=\"https://www.bizjournals.com/nashville/news/2026/07/28/wally-dietz-metro-nashville-tennessee-exit-retire.html\" data-vars-content-id=\"dd404bc5-fcbc-48f2-ba93-fce79e538607\" data-vars-headline=\"Mayoral aide Kristin Wilson resigns from top Metro post\" data-vars-event-category=\"story\" data-vars-sub-category=\"story\" data-vars-item=\"in_content_link\" href=\"https://www.bizjournals.com/nashville/news/2026/07/28/wally-dietz-metro-nashville-tennessee-exit-retire.html\" target=\"_blank\"\u003eWally Dietz\u003c/a\u003e.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eWhat they\u0026#x27;re saying: \u003c/strong\u003eWilson said in her resignation letter Tuesday she believes Metro is \u0026quot;in a better operational place than it was when I started.\u0026quot;\u003c/p\u003e\u003cul\u003e\u003cli\u003eO\u0026#x27;Connell lauded Wilson in a statement for \u0026quot;overseeing the city\u0026#x27;s response to some of our most profound tragedies and crises while also guiding us through a considerable era of growth in our city that impacted operations.\u0026quot;\u003c/li\u003e\u003c/ul\u003e\u003cspan data-ad-status=\"NO_AD_LENGTH\" data-ad-type=\"midStoryAd\"\u003e\u003c/span\u003e"},"primary_embed":null,"summary":"\u003cp\u003eKristin Wilson, one of Metro government\u0026#x27;s most consequential officials, is leaving Mayor Freddie O\u0026#x27;Connell\u0026#x27;s office.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eWhy it matters: \u003c/strong\u003eWilson serves as the city\u0026#x27;s chief of operations and performance, a behind-the-scenes role that is out of the public eye but at the center of the most pressing Metro issues.\u003c/p\u003e","primaryImageCaption":"\u003cp\u003eKristin Wilson. Photo: courtesy of Metro\u003c/p\u003e"},"audience":{"id":"11a79f3a-8967-42ee-8505-4a23b11afec5","name":"Nashville","local_logo_name":null,"slug":"nashville","audience_type":"local","public_stories":true,"public_jobs":false,"events_sellable":false,"cms_active_events":false,"cms_active_stories":true,"subscriptions":[{"id":"newsletter_axioslocal_nashville","name":"Axios Nashville","slug":"axios-nashville","branding_image":"https://static.axios.com/img/axios-site/axios-local-nashville-transparent.png","branding_image_alt_text":"Picture of the Nashville skyline.","color_scheme":{"id":7,"name":"blue","core":"#3054A6","shade":"#1C3B7A","medium":"#FFFFFF","tint":"#A1BDE0","light":"#E4EFFB","shadow":"#3054A633"},"description":"Get smarter, faster on what matters in Nashville with Nate Rau and Adam Tamburin.","pub_schedule":"Daily - Weekdays","subscription_type":"newsletter","category":"","audience":{"id":"11a79f3a-8967-42ee-8505-4a23b11afec5","name":"Nashville","local_logo_name":null,"slug":"nashville","audience_type":"local","timezone":"America/Chicago","default_paywall_status":"hidden"},"social_image":null,"social_square":null,"can_list":true,"can_subscribe":true,"permalink":"https://www.axios.com/newsletter