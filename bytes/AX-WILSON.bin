ontentSlug%5D","pageType":"story","gtmPageData":{"pageViewId":"2c6eff90-c029-40ae-85ec-793dc87150bc","pageType":"story","product":"local","subProduct":"nashville","contentId":"dd404bc5-fcbc-48f2-ba93-fce79e538607","topic":"News","authors":["Nate Rau"],"publishedDate":"2026-08-18T20:42:51.747561Z","topics":["News","Politics"],"subTopics":[],"tags":[],"wordCount":0,"headline":"Mayoral aide Kristin Wilson resigns from top Metro post"},"embedTypes":[],"data":{"story":{"slug":"mayoral-aide-kristin-wilson-resigns-from-top-metro-post","id":"dd404bc5-fcbc-48f2-ba93-fce79e538607","headline":"Mayoral aide Kristin Wilson resigns from top Metro post","seo_headline":"","authors":[{"username":"nrau","avatar_url":"https://images.axios.com/-ymogNic0nPD85WmF6AlNUwoCIo=/52x0/smart/2021/10/13/1634134785360.png","display_name":"Nate Rau","subscription":{"name":"Axios Nashville","slug":"axios-nashville","audience":{"slug":"nashville","name":"Nashville","audience_type":"local"}}}],"byline_photo":"https://images.axios.com/-ymogNic0nPD85WmF6AlNUwoCIo=/52x0/smart/2021/10/13/1634134785360.png","byline_photo_2x":"https://images.axios.com/Rs2Jc4BQ5iLSLfSjIiv_JvjY-ok=/104x0/smart/2021/10/13/1634134785360.png","blocks":{"blocks":[{"key":"d8i7m","text":"Kristin Wilson, one of Metro government's most consequential officials, is leaving Mayor Freddie O'Connell's office.","type":"unstyled","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"f0pbk","text":"Why it matters: Wilson serves as the city's chief of operations and performance, a behind-the-scenes role that is out of the public eye but at the center of the most pressing Metro issues.","type":"unstyled","depth":0,"inlineStyleRanges":[{"style":"BOLD","length":16,"offset":0}],"entityRanges":[],"data":{}},{"key":"e5pdh","text":"","type":"keep-reading","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{"readTime":"","buttonText":"Go deeper","showWordCount":true}},{"key":"em7u1","text":"Zoom in: Wilson worked with Metro for seven years, navigating the pandemic, the 2020 tornado, the Christmas bombing and school shootings.","type":"unstyled","depth":0,"inlineStyleRanges":[{"style":"BOLD","length":9,"offset":0}],"entityRanges":[],"data":{}},{"key":"vhke","text":"Her job is to make sure the city government operates efficiently. She served as one of the top aides to both O'Connell and his predecessor, Mayor John Cooper.","type":"unordered-list-item","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}},{"key":"11f3v","text":"Zoom out: Wilson is the fourth top aide to leave the mayor's office since July 2025. Other departures include former chief of staff Marjorie Pomeroy-Wallace, development chief Bob Mendes and legal director Wally Dietz.","type":"unstyled","depth":0,"inlineStyleRanges":[{"style":"BOLD","length":10,"offset":0}],"entityRanges":[{"offset":132,"length":24,"key":0},{"offset":176,"length":10,"key":1},{"offset":206,"length":11,"key":2}],"data":{}},{"key":"1b2uu","text":"What they're saying: Wilson said in her resignation letter Tuesday she believes Metro is \"in a better operational place than it was when I started.\"","type":"unstyled","depth":0,"inlineStyleRanges":[{"style":"BOLD","length":21,"offset":0}],"entityRanges":[],"data":{}},{"key":"3t9d2","text":"O'Connell lauded Wilson in a statement for \"overseeing the city's response to some of our most profound tragedies and crises while also guiding us through a considerable era of growth in our city that impacted operations.\"","type":"unordered-list-item","depth":0,"inlineStyleRanges":[],"entityRanges":[],"data":{}}],"entityMap":[{"type":"LINK","mutability":"MUTABLE","data":{"url":"https://www.axios.com/local/nashville/2025/07/08/mayor-oconnell-new-chief-of-staff-marjorie-pomeroy-wallace-moves-to-new-role","text":"Marjorie Pomeroy-Wallace","target":"_blank"}},{"type":"LINK","mutability":"MUTABLE","data":{"url":"https://www.axios.com/local/nashville/2025/09/24/top-oconnell-aide-bob-mendes-to-leave-the-mayors-office","text":"Bob Mendes","target":"_blank"}},{"type":"LINK","mutability":"MUTABLE","data":{"url":"https://www.bizjournals.com/nashville/news/2026/07/28/wally-dietz-metro-nashville-tennessee-exit-retire.html","text":"Wally Dietz","target":"_blank"}}]},"published_date":"2026-08-18T20:42:51.747561Z","last_published":"2026-08-18T20:42:51.747561Z","first_published":"2026-08-18T20:42:51.747561Z","primary_section":null,"cover_for_deep_dive":null,"deep_dive":null,"sections":[],"primary_tag":null,"tags":[],"is_featured":false,"new_featured":false,"permalink":"https://www.axios.com/local/nashville/2026/08/18/mayoral-aide-kristin-wilson-resigns-from-top-metro-post","amp_permalink":"https://amp.axios.com/mayoral-aide-kristin-wilson-resigns-from-top-metro-post-dd404bc5-fcbc-48f2-ba93-fce79e538607.html","primary_image":{"crops":{"1x1":{"url":"https://images.axios.com/vfGyeA8OqI_ZU6MfBBRylaQkuBs=/392x0:1472x1080/1080x1080/2026/08/18/1787083173388.jpeg","sizes":[{"url":"https://images.axios.com/ovN4OYOmzyi24gpCNvQrizBg-To=/392x0:1472x1080/1024x1024/2026/08/18/1787083173388.jpeg","width":1024,"height":1024},{"url":"https://images.axios.com/vmI4eEUFIAL-e_nv0lLcOUYHShI=/392x0:1472x1080/1366x1366/2026/08/18/1787083173388.jpeg","width":1366,"height":1366},{"url":"https://images.axios.com/jr2RsqB2yf7ZQetCcT1UmBqt5tk=/392x0:1472x1080/1600x1600/2026/08/18/1787083173388.jpeg","width":1600,"height":1600},{"url":"https://images.axios.com/4rCqy-Gy_lAq7nms_Yy2DnyzkTQ=/392x0:1472x1080/1920x1920/2026/08/18/1787083173388.jpeg","width":1920,"height":1920},{"url":"https://images.axios.com/7vH3_rV_pFxxcTTb6shZ9H9mln8=/392x0:1472x1080/320x320/2026/08/18/1787083173388.jpeg","width":320,"height":320},{"url":"https://images.axios.com/ifMiwRgdmHBB1CXsOANf-rblcLs=/392x0:1472x1080/640x640/2026/08/18/1787083173388.jpeg","width":640,"height":640},{"url":"https://images.axios.com/uW6GiUcH9el-ykL8SiXgZAAFpPY=/392x0:1472x1080/768x768/2026/08/18/1787083173388.jpeg","width":768,"height":768}]},"3x2":{"url":"https://im