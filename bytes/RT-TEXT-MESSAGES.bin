43ef-b1ac-e84ae97aae30_886x1198.png 848w, https://substackcdn.com/image/fetch/$s_!sW1q!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F27e5a4e4-e598-43ef-b1ac-e84ae97aae30_886x1198.png 1272w, https://substackcdn.com/image/fetch/$s_!sW1q!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F27e5a4e4-e598-43ef-b1ac-e84ae97aae30_886x1198.png 1456w\\\" sizes=\\\"100vw\\\"><img src=\\\"https://substackcdn.com/image/fetch/$s_!sW1q!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F27e5a4e4-e598-43ef-b1ac-e84ae97aae30_886x1198.png\\\" width=\\\"886\\\" height=\\\"1198\\\" data-attrs=\\\"{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/27e5a4e4-e598-43ef-b1ac-e84ae97aae30_886x1198.png&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:1198,&quot;width&quot;:886,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:1076667,&quot;alt&quot;:null,&quot;title&quot;:null,&quot;type&quot;:&quot;image/png&quot;,&quot;href&quot;:null,&quot;belowTheFold&quot;:false,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://readrichtext.substack.com/i/178456949?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F868020a1-34fb-4330-88d7-346fe35cb335_886x1198.png&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}\\\" class=\\\"sizing-normal\\\" alt=\\\"\\\" srcset=\\\"https://substackcdn.com/image/fetch/$s_!sW1q!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F27e5a4e4-e598-43ef-b1ac-e84ae97aae30_886x1198.png 424w, https://substackcdn.com/image/fetch/$s_!sW1q!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F27e5a4e4-e598-43ef-b1ac-e84ae97aae30_886x1198.png 848w, https://substackcdn.com/image/fetch/$s_!sW1q!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F27e5a4e4-e598-43ef-b1ac-e84ae97aae30_886x1198.png 1272w, https://substackcdn.com/image/fetch/$s_!sW1q!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F27e5a4e4-e598-43ef-b1ac-e84ae97aae30_886x1198.png 1456w\\\" sizes=\\\"100vw\\\"></picture><div class=\\\"image-link-expand\\\"><div class=\\\"pencraft pc-display-flex pc-gap-8 pc-reset\\\"><button tabindex=\\\"0\\\" type=\\\"button\\\" class=\\\"pencraft pc-reset pencraft icon-container restack-image\\\"><svg aria-hidden=\\\"true\\\" width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 20 20\\\" fill=\\\"none\\\" stroke-width=\\\"1.5\\\" stroke=\\\"var(--color-fg-primary)\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><g><path d=\\\"M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882\\\"></path></g></svg></button><button tabindex=\\\"0\\\" type=\\\"button\\\" class=\\\"pencraft pc-reset pencraft icon-container view-image\\\"><svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" class=\\\"lucide lucide-maximize2 lucide-maximize-2\\\"><polyline points=\\\"15 3 21 3 21 9\\\"></polyline><polyline points=\\\"9 21 3 21 3 15\\\"></polyline><line x1=\\\"21\\\" x2=\\\"14\\\" y1=\\\"3\\\" y2=\\\"10\\\"></line><line x1=\\\"3\\\" x2=\\\"10\\\" y1=\\\"21\\\" y2=\\\"14\\\"></line></svg></button></div></div></div></a><figcaption class=\\\"image-caption\\\">Text messages that were shared with me between Director Calvin and her staff from Aug 3, 2024 demonstrating her sharing confidential HMIS documents and making ad hoc housing placements decisions.</figcaption></figure></div><p>On Saturday morning, August 3, 2024, Nashville\u2019s Office of Homeless Services Director April Calvin texted her staff to personally select which unhoused families would receive housing\u2014reviewing confidential case records via text message, removing families from consideration based on their size, and coordinating placements outside the city\u2019s federally mandated Coordinated Entry system that exists precisely to prevent this kind of ad hoc decision-making.</p><p>Recent reporting on Nashville\u2019s Office of Homeless Services has revealed what appears to be a housing program launched with minimal public notice in summer 2024, relocating unhoused families into housing units under what\u2019s classified in the fiscal year 2026 budget as \u201Cnon-traditional rapid rehousing.\u201D Reports are this program may also be referred to going forward as \u201CMetro Rapid Response Funds\u201D or \u201CMRRF.\u201D</p><div class=\\\"captioned-image-container\\\"><figure><a class=\\\"image-link image2\\\" target=\\\"_blank\\\" href=\\\"https://substackcdn.com/image/fetch/$s_!vUsr!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7908b343-8ea1-494f-bcf1-909db29744d6_1948x52.png\\\" data-component-name=\\\"Image2ToDOM\\\"><div class=\\\"image2-inset\\\"><picture><source type=\\\"image/webp\\\" srcset=\\\"https://substackcdn.com/image/fetch/$s_!vUsr!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7908b343-8ea1-494f-bcf1-909db29744d6_1948x52.png 424w, https://substackcdn.com/image/fetch/$s_!vUsr!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7908b343-8ea1-494f-bcf1-909db29744d6_1948x52.png 848w, https://substackcdn.com/image/fetch/$s_!vUsr!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7908b343-8ea1-494f-bcf1-909db29744d6_1948x52.png 1272w, https://substackcdn.com/image/fetch/$s_!vUsr!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7908b343-8ea1-494f-bcf1-909db29744d6_1948x52.png 1456w\\\" sizes=\\\"100vw\\\"><img src=\\\"https://substackcdn.com/image/fetch/$s_!vUsr!,w_2400,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7908b343-8ea1-494f-bcf1-909db29744d6_1948x52.png\\\" width=\\\"1200\\\" height=\\\"32.142857142857146\\\" data-attrs=\\\"{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/7908b343-8ea1-494f-bcf1-909db29744d6_1948x52.png&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:false,&quot;imageSize&quot;:&quot;large&quot;,&quot;height&quot;:39,&quot;width&quot;:1456,&quot;resizeWidth&quot;:1200,&quot;bytes&quot;:31057,&quot;alt&quot;:null,&quot;title&quot;:null,&quot;type&quot;:&quot;image/png&quot;,&quot;href&quot;:null,&quot;belowTheFold&quot;:false,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://readrichtext.substack.com/i/178456949?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7908b343-8ea1-494f-bcf1-909db29744d6_1948x52.png&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:&quot;center&quot;,&quot;offset&quot;:false}\\\" class=\\\"sizing-large\\\" alt=\\\"\\\" srcset=\\\"https://substackcdn.com/image/fetch/$s_!vUsr!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7908b343-8ea1-494f-bcf1-909db29744d6_1948x52.png 424w, https://substackcdn.com/image/fetch/$s_!vUsr!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7908b343-8ea1-494f-bcf1-909db29744d6_1948x52.png 848w, https://substackcdn.com/image/fetch/$s_!vUsr!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7908b343-8ea1-494f-bcf1-909db29744d6_1948x52.png 1272w, https://substackcdn.com/image/fetch/$s_!vUsr!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7908b343-8ea1-494f-bcf1-909db29744d6_1948x52.png 1456w\\\" sizes=\\\"100vw\\\"></picture><div></div></div></a><figcaption class=\\\"image-caption\\\">A line item from OHS\u2019 ledger book with the memo line \u201COHS NOV 2024 RENT\u201D billed to \u201CHillside Crossing LLC\u201D. The accounting string notes that it was billed against the ARPA Fund 30216, in a business unit related to <a href=\\\"https://nashville.legistar.com/LegislationDetail.aspx?ID=6706795&amp;GUID=3911D2DC-BA71-4A2D-B975-458961A0A8A8\\\">RS2024-490</a> which allocated OHS ARPA Funds for Strobel House.</figcaption></figure></div><p>The program appears to trace back to placements beginning at least in summer and fall of 2024, when no fewer than eight families were placed into housing under the direct coordination of OHS Director April Calvin and the Nashville Rescue Mission. Leases were drawn up under Metro supervision, and rent began being paid using ARPA funds that do not appear to have been obligated for such purposes.</p><div class=\\\"captioned-image-container\\\"><figure><a class=\\\"image-link image2 is-viewable-img\\\" target=\\\"_blank\\\" href=\\\"https://substackcdn.com/image/fetch/$s_!EZVE!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5259e4c9-fe6a-427d-a912-7bcfe101b7f4_1642x552.png\\\" data-component-name=\\\"Image2ToDOM\\\"><div class=\\\"image2-inset\\\"><picture><source type=\\\"image/webp\\\" srcset=\\\"https://substackcdn.com/image/fetch/$s_!EZVE!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5259e4c9-fe6a-427d-a912-7bcfe101b7f4_1642x552.png 424w, https://substackcdn.com/image/fetch/$s_!EZVE!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5259e4c9-fe6a-427d-a912-7bcfe101b7f4_1642x552.png 848w, https://substackcdn.com/image/fetch/$s_!EZVE!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5259e4c9-fe6a-427d-a912-7bcfe101b7f4_1642x552.png 1272w, https://substackcdn.com/image/fetch/$s_!EZVE!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5259e4c9-fe6a-427d-a912-7bcfe101b7f4_1642x552.png 1456w\\\" sizes=\\\"100vw\\\"><img src=\\\"https://substackcdn.com/image/fetch/$s_!EZVE!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5259e4c9-fe6a-427d-a912-7bcfe101b7f4_1642x552.png\\\" width=\\\"1456\\\" height=\\\"489\\\" data-attrs=\\\"{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/5259e4c9-fe6a-427d-a912-7bcfe101b7f4_1642x552.png&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:489,&quot;width&quot;:1456,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:149340,&quot;alt&quot;:null,&quot;title&quot;:null,&quot;type&quot;:&quot;image/png&quot;,&quot;href&quot;:null,&quot;belowTheFold&quot;:false,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://readrichtext.substack.com/i/178456949?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5259e4c9-fe6a-427d-a912-7bcfe101b7f4_1642x552.png&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}\\\" class=\\\"sizing-normal\\\" alt=\\\"\\\" srcset=\\\"https://substackcdn.com/image/fetch/$s_!EZVE!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5259e4c9-fe6a-427d-a912-7bcfe101b7f4_1642x552.png 424w, https://substackcdn.com/image/fetch/$s_!EZVE!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5259e4c9-fe6a-427d-a912-7bcfe101b7f4_1642x552.png 848w, https://substackcdn.com/image/fetch/$s_!EZVE!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5259e4c9-fe6a-427d-a912-7bcfe101b7f4_1642x552.png 1272w, https://substackcdn.com/image/fetch/$s_!EZVE!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5259e4c9-fe6a-427d-a912-7bcfe101b7f4_1642x552.png 1456w\\\" sizes=\\\"100vw\\\"></picture><div class=\\\"image-link-expand\\\"><div class=\\\"pencraft pc-display-flex pc-gap-8 pc-reset\\\"><button tabindex=\\\"0\\\" type=\\\"button\\\" class=\\\"pencraft pc-reset pencraft icon-container restack-image\\\"><svg aria-hidden=\\\"true\\\" width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 20 20\\\" fill=\\\"none\\\" stroke-width=\\\"1.5\\\" stroke=\\\"var(--color-fg-primary)\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><g><path d=\\\"M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882\\\"></path></g></svg></button><button tabindex=\\\"0\\\" type=\\\"button\\\" class=\\\"pencraft pc-reset pencraft icon-container view-image\\\"><svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" class=\\\"lucide lucide-maximize2 lucide-maximize-2\\\"><polyline points=\\\"15 3 21 3 21 9\\\"></polyline><polyline points=\\\"9 21 3 21 3 15\\\"></polyline><line x1=\\\"21\\\" x2=\\\"14\\\" y1=\\\"3\\\" y2=\\\"10\\\"></line><line x1=\\\"3\\\" x2=\\\"10\\\" y1=\\\"21\\\" y2=\\\"14\\\"></line></svg></button></div></div></div></a><figcaption class=\\\"image-caption\\\">Calvin\u2019s response to my inquiry regarding why these families were still receiving eviction notices, over a month after I had brought this issue to the attention of Calvin and the Mayor\u2019s Office.</figcaption></figure></div><p>The families were taken from the Nashville Rescue Mission and placed into housing units at two locations: 3230 Clarksville Pike and 717 Spence Lane. Families were shuttled over to the properties and told they would receive a year of paid rent and housing vouchers for participating in the program, according to two families interviewed and a case manager with an organization responsible for providing support services to these families.</p><div class=\\\"pullquote\\\"><p>If you\u2019re not already subscribed for this investigation or this Substack and want to see all the relevant content, choose one of these options below.</p><div class=\\\"captioned-image-container\\\"><figure><a class=\\\"image-link image2 is-viewable-img\\\" target=\\\"_blank\\\" href=\\\"https://clovenbradshaw-ctrl.github.io/municpal/https://clovenbradshaw-ctrl.github.io/municpal/\\\" data-component-name=\\\"Image2ToDOM\\\"><div class=\\\"image2-inset\\\"><picture><source type=\\\"image/webp\\\" srcset=\\\"https://substackcdn.com/image/fetch/$s_!iB5e!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F91596044-df5b-450a-acaf-9c4c7101fb8d_1728x1612.png 424w, https://substackcdn.com/image/fetch/$s_!iB5e!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F91596044-df5b-450a-acaf-9c4c7101fb8d_1728x1612.png 848w, https://substackcdn.com/image/fetch/$s_!iB5e!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F91596044-df5b-450a-acaf-9c4c7101fb8d_1728x1612.png 1272w, https://substackcdn.com/image/fetch/$s_!iB5e!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F91596044-df5b-450a-acaf-9c4c7101fb8d_1728x1612.png 1456w\\\" sizes=\\\"100vw\\\"><img src=\\\"https://substackcdn.com/image/fetch/$s_!iB5e!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F91596044-df5b-450a-acaf-9c4c7101fb8d_1728x1612.png\\\" width=\\\"491\\\" height=\\\"457.9519230769231\\\" data-attrs=\\\"{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/91596044-df5b-450a-acaf-9c4c7101fb8d_1728x1612.png&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:1358,&quot;width&quot;:1456,&quot;resizeWidth&quot;:491,&quot;bytes&quot;:224820,&quot;alt&quot;:&quot;&quot;,&quot;title&quot;:null,&quot;type&quot;:&quot;image/png&quot;,&quot;href&quot;:&quot;https://clovenbradshaw-ctrl.github.io/municpal/https://clovenbradshaw-ctrl.github.io/municpal/&quot;,&quot;belowTheFold&quot;:false,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://readrichtext.substack.com/i/178456949?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F91596044-df5b-450a-acaf-9c4c7101fb8d_1728x1612.png&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}\\\" class=\\\"sizing-normal\\\" alt=\\\"\\\" title=\\\"\\\" srcset=\\\"https://substackcdn.com/image/fetch/$s_!iB5e!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F91596044-df5b-450a-acaf-9c4c7101fb8d_1728x1612.png 424w, https://substackcdn.com/image/fetch/$s_!iB5e!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F91596044-df5b-450a-acaf-9c4c7101fb8d_1728x1612.png 848w, https://substackcdn.com/image/fetch/$s_!iB5e!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F91596044-df5b-450a-acaf-9c4c7101fb8d_1728x1612.png 1272w, https://substackcdn.com/image/fetch/$s_!iB5e!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F91596044-df5b-450a-acaf-9c4c7101fb8d_1728x1612.png 1456w\\\" sizes=\\\"100vw\\\"></picture><div class=\\\"image-link-expand\\\"><div class=\\\"pencraft pc-display-flex pc-gap-8 pc-reset\\\"><button tabindex=\\\"0\\\" type=\\\"button\\\" class=\\\"pencraft pc-reset pencraft icon-container restack-image\\\"><svg aria-hidden=\\\"true\\\" width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 20 20\\\" fill=\\\"none\\\" stroke-width=\\\"1.5\\\" stroke=\\\"var(--color-fg-primary)\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><g><path d=\\\"M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882\\\"></path></g></svg></button><button tabindex=\\\"0\\\" type=\\\"button\\\" class=\\\"pencraft pc-reset pencraft icon-container view-image\\\"><svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" class=\\\"lucide lucide-maximize2 lucide-maximize-2\\\"><polyline points=\\\"15 3 21 3 21 9\\\"></polyline><polyline points=\\\"9 21 3 21 3 15\\\"></polyline><line x1=\\\"21\\\" x2=\\\"14\\\" y1=\\\"3\\\" y2=\\\"10\\\"></line><line x1=\\\"3\\\" x2=\\\"10\\\" y1=\\\"21\\\" y2=\\\"14\\\"></line></svg></button></div></div></div></a></figure></div></div><h2><strong>An Extraordinary Claim Requires Documentation</strong></h2><p>These are extraordinary claims: that the department in charge of a federally mandated program designed to provide equitable access to scarce housing resources (Coordinated Entry (CE))  has its director making these life-altering decisions outside of any recognized best practices.<a class=\\\"footnote-anchor\\\" data-component-name=\\\"FootnoteAnchorToDOM\\\" id=\\\"footnote-anchor-1\\\" href=\\\"#footnote-1\\\" target=\\\"_self\\\">1</a></p><p>A claim like that is nothing I would post on my Substack without documentation. It is a claim I\u2019m sure the Nashville Scene would never make without seeing evidence of this.</p><p>So now I would like you to be able to see what we\u2019ve seen.</p><h2><strong>The Text Messages</strong></h2><p>Below are screenshots of a text thread conversation Director Calvin had in August of 2024, wherein she was texting with her OHS staff, sending them confidential HMIS documents with private unique identifiers visible even in the unredacted screenshots.</p><p>Evident in these messages is Director Calvin deciding which particular families will be receiving promises of a year of free housing and a housing voucher\u2014promises that, notably, none of the families fully received. All were told that their promised year of paid rent was being withdrawn, and eventually received eviction notices as OHS stopped paying their rent. And at least two families did not receive the promised vouchers that OHS incentivized them with to leave the Rescue Mission.</p><p>On Saturday, August 3, 2024, at 7:31 AM, Calvin texted her staff:</p><blockquote><p>\u201CLadies we are reducing our number to 8 smaller families that Ohs will house from the Mission due to the properties that are available.</p><p>\u201CThe 8 families will be housed at two different hotel conversions.</p><p>\u201C[OHS employee name redacted] please select the families that have smaller kids or smaller family size.\u201D</p></blockquote><p>Calvin then reviewed individual HMIS records showing family details, including names, HMIS numbers, number of children, income sources (SSI/SSDI), and other personal information\u2014all shared via text message.</p><p>After reviewing one family\u2019s information, Calvin wrote: \u201CI only saw one family with 3 kids Let\u2019s remove them from the list and...\u201D</p><p>The staff member responded that she would \u201Cdo this and send out the notification and will call [case manager for Nashville Rescue Mission].\u201D Another asked about mobility accommodations for the ground-floor units.</p><p>Later that same day, Calvin wrote: \u201CThe next referral to advocate for on the case coordination meeting,\u201D referring to another family. A staff member noted one individual \u201CMay have trouble with stairs. That\u2019s the only mobility problem.\u201D</p><p>Calvin responded with approval, noting she would ensure this person received a ground-floor unit.</p><p>The staff member then messaged: \u201CNot that I am aware of. [case manager for Nashville Rescue Mission] would have mentioned that, but I will double check.\u201D</p><p>After another staff member asked for clarification, the response came: \u201COh - sorry, yes - it is [case manager for Nashville Rescue Mission]. Can I give her your phone number?\u201D</p><p>By the end of the exchange, Calvin had personally reviewed and approved which families would receive housing, which would be removed from consideration, and sent the final list to property management with instructions to prepare lease agreements for Monday, August 5, 2024. These families entered into contracts with a landlord, being told OHS would be paying their rent for a year. Metro chose the families, the landlords, and arranged the leases. But by April, they were reneging on their promise and eviction notices starting showing up.</p><p>Despite coordinating all aspects of this process, Metro and OHS appear nowhere on these leases. </p><p>Below you can read the text message exchange. If you do not already have access, click the image below and choose which way you\u2019d like to gain access.</p><div class=\\\"captioned-image-container\\\"><figure><a class=\\\"image-link image2 is-viewable-img\\\" target=\\\"_blank\\\" href=\\\"https://clovenbradshaw-ctrl.github.io/municpal/\\\" data-component-name=\\\"Image2ToDOM\\\"><div class=\\\"image2-inset\\\"><picture><source type=\\\"image/webp\\\" srcset=\\\"https://substackcdn.com/image/fetch/$s_!iB5e!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F91596044-df5b-450a-acaf-9c4c7101fb8d_1728x1612.png 424w, https://substackcdn.com/image/fetch/$s_!iB5e!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F91596044-df5b-450a-acaf-9c4c7101fb8d_1728x1612.png 848w, https://substackcdn.com/image/fetch/$s_!iB5e!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F91596044-df5b-450a-acaf-9c4c7101fb8d_1728x1612.png 1272w, https://substackcdn.com/image/fetch/$s_!iB5e!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F91596044-df5b-450a-acaf-9c4c7101fb8d_1728x1612.png 1456w\\\" sizes=\\\"100vw\\\"><img src=\\\"https://substackcdn.com/image/fetch/$s_!iB5e!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F91596044-df5b-450a-acaf-9c4c7101fb8d_1728x1612.png\\\" width=\\\"1456\\\" height=\\\"1358\\\" data-attrs=\\\"{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/91596044-df5b-450a-acaf-9c4c7101fb8d_1728x1612.png&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:1358,&quot;width&quot;:1456,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:224820,&quot;alt&quot;:null,&quot;title&quot;:null,&quot;type&quot;:&quot;image/png&quot;,&quot;href&quot;:&quot;https://clovenbradshaw-ctrl.github.io/municpal/&quot;,&quot;belowTheFold&quot;:true,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://readrichtext.substack.com/i/178456949?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F91596044-df5b-450a-acaf-9c4c7101fb8d_1728x1612.png&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}\\\" class=\\\"sizing-normal\\\" alt=\\\"\\\" srcset=\\\"https://substackcdn.com/image/fetch/$s_!iB5e!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F91596044-df5b-450a-acaf-9c4c7101fb8d_1728x1612.png 424w, https://substackcdn.com/image/fetch/$s_!iB5e!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F91596044-df5b-450a-acaf-9c4c7101fb8d_1728x1612.png 848w, https://substackcdn.com/image/fetch/$s_!iB5e!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F91596044-df5b-450a-acaf-9c4c7101fb8d_1728x1612.png 1272w, https://substackcdn.com/image/fetch/$s_!iB5e!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F91596044-df5b-450a-acaf-9c4c7101fb8d_1728x1612.png 1456w\\\" sizes=\\\"100vw\\\" loading=\\\"lazy\\\"></picture><div class=\\\"image-link-expand\\\"><div class=\\\"pencraft pc-display-flex pc-gap-8 pc-reset\\\"><button tabindex=\\\"0\\\" type=\\\"button\\\" class=\\\"pencraft pc-reset pencraft icon-container restack-image\\\"><svg aria-hidden=\\\"true\\\" width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 20 20\\\" fill=\\\"none\\\" stroke-width=\\\"1.5\\\" stroke=\\\"var(--color-fg-primary)\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" xmlns=\\\"http://www.w3.org/2000/svg\\\"><g><path d=\\\"M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882\\\"></path></g></svg></button><button tabindex=\\\"0\\\" type=\\\"button\\\" class=\\\"pencraft pc-reset pencraft icon-container view-image\\\"><svg xmlns=\\\"http://www.w3.org/2000/svg\\\" width=\\\"20\\\" height=\\\"20\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" class=\\\"lucide lucide-maximize2 lucide-maximize-2\\\"><polyline points=\\\"15 3 21 3 21 9\\\"></polyline><polyline points=\\\"9 21 3 21 3 15\\\"></polyline><line x1=\\\"21\\\" x2=\\\"14\\\" y1=\\\"3\\\" y2=\\\"10\\\"></line><line x1=\\\"3\\\" x2=\\\"10\\\" y1=\\\"21\\\" y2=\\\"14\\\"></line></svg></button></div></div></div></a></figure></div><p></p>\",\"has_dynamic_content\":false,\"truncated_body_text\":\"On Saturday morning, August 3, 2024, Nashville\u2019s Office of Homeless Services Director April Calvin texted her staff to personally select which unhoused families would receive housing\u2014reviewing confidential case records via text message, removing families from consideration based on their size, and coordinating placements outside the city\u2019s federally mandated Coordinated Entry system that exists precisely to prevent this kind of ad hoc decision-making.\",\"wordcount\":949,\"post_preview_limit\":null,\"language\":\"en\",\"postTags\":[],\"postCountryBlocks\":[],\"headlineTest\":null,\"coverImagePalette\":{\"Vibrant\":{\"rgb\":[44,136,236],\"population\":26},\"DarkVibrant\":{\"rgb\":[12,40,69],\"population\":6},\"LightVibrant\":{\"rgb\":[108,169,230],\"population\":38},\"Muted\":{\"rgb\":[140,156,92],\"population\":1},\"DarkMuted\":{\"rgb\":[36,44,60],\"population\":1566},\"LightMuted\":{\"rgb\":[220,212,196],\"population\":3}},\"publishedBylines\":[{\"id\":3407271,\"name\":\"Rich Text\",\"handle\":\"readrichtext\",\"previous_name\":\"Mike Lacy\",\"photo_url\":\"https://substack-post-media.s3.amazonaws.com/public/images/8722a66c-f873-4b99-ab10-2486beab6bd0_788x788.png\",\"bio\":\"Tom Cruise Expert // Not on socials.\",\"profile_set_up_at\":\"2024-01-01T21:03:51.344Z\",\"reader_installed_at\":\"2024-05-13T15:30:41.952Z\",\"publicationUsers\":[{\"id\":2235285,\"user_id\":3407271,\"publication_id\":2219733,\"role\":\"admin\",\"public\":true,\"is_primary\":true,\"publication\":{\"id\":2219733,\"name\":\"{Rich Text}\",\"subdomain\":\"readrichtext\",\"custom_domain\":null,\"custom_domain_optional\":false,\"hero_text\":\"Nashville politics, metamodern philosophy, nonboring data science musings, and an unhealthy interest in Tom Cruise. Best of Nashville 2025 \\\"Best Metro Watchdog\\\".\\n\\nContact me securely on Signal:\\nhttps://signal.me/#eu/0sH-qog826fh91_3ZkY3XycscZO93L8T2Bbf2kZ\",\"logo_url\":\"https://substack-post-media.s3.amazonaws.com/public/images/b0e1df60-e27a-4eba-80d8-cf1082cf8d0d_500x500.png\",\"author_id\":3407271,\"primary_user_id\":null,\"theme_var_background_pop\":\"#FF0000\",\"created_at\":\"2024-01-01T21:03:53.808Z\",\"email_from_name\":null,\"copyright\":\"Prometheoid Writes\",\"founding_plan_name\":\"Charter Members\",\"community_enabled\":true,\"invite_only\":false,\"payments_state\":\"enabled\",\"language\":null,\"explicit\":false,\"homepage_type\":\"newspaper\",\"is_personal_mode\":false,\"logo_url_wide\":null}},{\"id\":9278607,\"user_id\":3407271,\"publication_id\":9049425,\"role\":\"admin\",\"public\":true,\"is_primary\":false,\"publication\":{\"id\":9049425,\"name\":\"{Plain Text}\",\"subdomain\":\"readplaintext\",\"custom_domain\":null,\"custom_domain_optional\":false,\"hero_text\":\"A short-form digest from {Rich Text} for people who care about surveillance, public space, urbanism, and the commons.\",\"logo_url\":\"https://substack-post-media.s3.amazonaws.com/public/images/ecf6b580-5a29-4cc6-91ae-2a58eca82b11_1280x1280.png\",\"author_id\":3407271,\"primary_user_id\":null,\"theme_var_background_pop\":\"#FF6719\",\"created_at\":\"2026-05-14T02:44:21.287Z\",\"email_from_name\":\"{Plain Text}\",\"copyright\":\"Rich Text\",\"founding_plan_name\":null,\"community_enabled\":true,\"invite_only\":false,\"payments_state\":\"disabled\",\"language\":null,\"explicit\":false,\"homepage_type\":\"profile\",\"is_personal_mode\":false,\"logo_url_wide\":null}}],\"is_guest\":false,\"bestseller_tier\":null,\"status\":{\"bestsellerTier\":null,\"subscriberTier\":1,\"leaderboard\":null,\"vip\":false,\"badge\":{\"type\":\"subscriber\",\"tier\":1,\"accent_colors\":null},\"subscriber\":null}}],\"reaction\":null,\"reaction_count\":3,\"comment_count\":0,\"child_comment_count\":0,\"audio_items\":[{\"post_id\":178456949,\"voice_id\":\"en-US-NovaTurboMultilingualNeural\",\"audio_url\":null,\"type\":\"tts\",\"status\":\"paywalled\"}],\"is_geoblocked\":false,\"hidden\":true,\"hasCashtag\":false},\"comments\":[],\"canonicalUrl\":\"https://readrichtext.substack.com/p/null_results-text-messages-reveal\",\"inlineComments\":false,\"readerIsSearchCrawler\":false,\"ogUrl\":\"https://readrichtext.substack.com/p/null_results-text-messages-reveal\",\"bannedFromNotes\":false,\"themeVariables\":{\"color_theme_bg_pop\":\"#51b4e9\",\"background_pop\":\"#51b4e9\",\"color_theme_bg_web\":\"#fafafa\",\"cover_bg_color\":\"#fafafa\",\"cover_bg_color_secondary\":\"#ebebeb\",\"background_pop_darken\":\"#3aaae6\",\"print_on_pop\":\"#ffffff\",\"color_theme_bg_pop_darken\":\"#3aaae6\",\"color_theme_print_on_pop\":\"#ffffff\",\"color_theme_bg_pop_20\":\"rgba(81, 180, 233, 0.2)\",\"color_theme_bg_pop_30\":\"rgba(81, 180, 233, 0.3)\",\"print_pop\":\"#51b4e9\",\"color_theme_accent\":\"#51b4e9\",\"cover_print_primary\":\"#363737\",\"cover_print_secondary\":\"#757575\",\"cover_print_tertiary\":\"#b6b6b6\",\"cover_border_color\":\"#51b4e9\",\"font_family_headings_preset\":\"'SF Pro Display', -apple-system, system-ui, BlinkMacSystemFont, 'Inter', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol'\",\"font_weight_headings_preset\":900,\"font_family_body_preset\":\"'Roboto Slab',sans-serif\",\"font_weight_body_preset\":400,\"font_preset_heading\":\"heavy_sans\",\"home_hero\":\"newspaper\",\"home_posts\":\"list\",\"web_bg_color\":\"#fafafa\",\"background_contrast_1\":\"#ebebeb\",\"background_contrast_2\":\"#d8d8d8\",\"background_contrast_3\":\"#b3b3b3\",\"background_contrast_4\":\"#909090\",\"background_contrast_5\":\"#4f4f4f\",\"color_theme_bg_contrast_1\":\"#ebebeb\",\"color_theme_bg_contrast_2\":\"#d8d8d8\",\"color_theme_bg_contrast_3\":\"#b3b3b3\",\"color_theme_bg_contrast_4\":\"#909090\",\"color_theme_bg_contrast_5\":\"#4f4f4f\",\"color_theme_bg_elevated\":\"#fafafa\",\"color_theme_bg_elevated_secondary\":\"#ebebeb\",\"color_theme_bg_elevated_tertiary\":\"#d8d8d8\",\"color_them