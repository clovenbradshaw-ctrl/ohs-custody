			<script type="text/javascript">
			var myCounter, counter, variant, card, variantValue, origin, nxsurl;

			var cards      = [{"layout":"minimalist","autoturn":"1","timer":"5","datasource":"chartbeat","title":"Read Next","linktext":"Next story"}];
			var posts      = [{"id":1518374,"title":"\u2018A war zone\u2019: Neighbors say 50 to 100 shots fired in South Nashville shootout","url":"https:\/\/www.wkrn.com\/news\/local-news\/nashville\/a-war-zone-neighbors-say-50-to-100-shots-fired-in-south-nashville-shootout\/","image":"https:\/\/www.wkrn.com\/wp-content\/uploads\/sites\/73\/2023\/10\/Illuzions-shooting.jpg"},{"id":1512744,"title":"Tennessee restaurant takes No. 1 spot on TripAdvisor&#8217;s list of top-rated &#8216;hidden gems&#8217;","url":"https:\/\/www.wkrn.com\/news\/tennessee-restaurant-takes-no-1-spot-on-tripadvisors-list-of-top-rated-hidden-gems\/","image":"https:\/\/www.wkrn.com\/wp-content\/uploads\/sites\/73\/2023\/09\/WomanEatingFalafelGettyImages-1053123306.jpg"},{"id":1517839,"title":"Best public high schools in Tennessee, according to Niche","url":"https:\/\/www.wkrn.com\/news\/tennessee-news\/tn-best-public-high-schools-2024\/","image":"https:\/\/www.wkrn.com\/wp-content\/uploads\/sites\/73\/2022\/01\/generic-school-classroom-2.jpg"},{"id":1518321,"title":"Starlink satellites will be visible Monday in Middle Tennessee, here&#8217;s where and when","url":"https:\/\/www.wkrn.com\/news\/local-news\/starlink-satellites-will-be-visible-in-tn-where-when\/","image":"https:\/\/www.wkrn.com\/wp-content\/uploads\/sites\/73\/2023\/02\/AP21133816941730-1.jpg"},{"id":1512677,"title":"NOAA releases 2023-2024 winter predictions: How will Tennessee be impacted?","url":"https:\/\/www.wkrn.com\/news\/national\/noaa-releases-2023-2024-winter-predictions\/","image":"https:\/\/www.wkrn.com\/wp-content\/uploads\/sites\/73\/2023\/09\/GettyImages-1191292846-1-e1695838524217.jpg"},{"id":1515778,"title":"Haunted places in Middle Tennessee","url":"https:\/\/www.wkrn.com\/news\/local-news\/tn-most-haunted-places\/","image":"https:\/\/www.wkrn.com\/wp-content\/uploads\/sites\/73\/2022\/09\/Haunted-Tennessee.jpg"},{"id":1517104,"title":"Decherd officer arrested, fired after drug sting operation","url":"https:\/\/www.wkrn.com\/news\/local-news\/decherd-officer-arrested-fired-after-drug-sting-operation\/","image":"https:\/\/www.wkrn.com\/wp-content\/uploads\/sites\/73\/2023\/02\/police-lights-generic_30929150_ver1.0-7.jpg"},{"id":1517405,"title":"Neighbors find &#8216;disturbing&#8217; KKK fliers in East Nashville","url":"https:\/\/www.wkrn.com\/news\/local-news\/nashville\/neighbors-find-disturbing-kkk-fliers-in-east-nashville\/","image":"https:\/\/www.wkrn.com\/wp-content\/uploads\/sites\/73\/2023\/10\/Flyers-found-in-East-Nashville.jpg"},{"id":1517067,"title":"DeAndre Hopkins returns to Clemson to finish degree","url":"https:\/\/www.wkrn.com\/sports\/tennessee-titans\/deandre-hopkins-returns-to-clemson-to-finish-degree\/","image":"https:\/\/www.wkrn.com\/wp-content\/uploads\/sites\/73\/2023\/10\/gettyimages-1694739346-594x594-1.jpg"},{"id":1517518,"title":"2 injured after Cruise robotaxi crashes into Midtown apartment building","url":"https:\/\/www.wkrn.com\/news\/local-news\/nashville\/no-injuries-reported-after-truck-crashes-into-midtown-apartment-building\/","image":"https:\/\/www.wkrn.com\/wp-content\/uploads\/sites\/73\/2023\/10\/Church-Street-car-into-building-.jpg"}];
			var current_id = 1488826;
			var nxsparam   = 0;

			document.addEventListener("DOMContentLoaded", function() {
				setTimeout(firstLoad, 300);
			});

			function firstLoad() {
				if(getCookie('nxst-story-id')){
					origin = getCookie('nxst-story-id');
				}

				if ( nxsparam >= posts.length ) {
					return;
				}
				while ( ( posts[nxsparam]["id"] == current_id ) || ( posts[nxsparam]["id"] == origin ) ) {
					nxsparam++;
					if ( nxsparam >= posts.length ) {
						return;
					}
				}

				Array.from(document.getElementsByClassName("nxslink")).forEach(function(elem) {
					nxsurl = posts[nxsparam]["url"] + "?nxsparam=" + (nxsparam+1);
					elem.setAttribute("href", nxsurl);
				});
				document.querySelectorAll('#btn-next').forEach(e => e.setAttribute('href', nxsurl))
				Array.from(document.getElementsByClassName("nxstitle")).forEach(function(elem) {
					elem.innerHTML = posts[nxsparam]["title"];
				});
				if(posts[nxsparam]["image"]){
					Array.from(document.getElementsByClassName("nxsimage")).forEach(function(elem) {
						elem.setAttribute("src", posts[nxsparam]["image"]);
					});
				} else {
					Array.from(document.getElementsByClassName("col-image")).forEach(function(elem) {
						elem.style.display = "none";
					});
				}

				if(getCookie('nxstoryVariation') == 'nxstory-auto-minimalist'){
					variantValue = getCookie('nxstoryVariation');
				} else{
					variantValue = 'nxstory-auto-minimalist';
				}

				card = cards.find(elem => elem['layout'] == 'minimalist' && elem['autoturn'] == 1);
				variant = 4;

				if(card['datasource'] == ''){
					return;
				}

				setCookie('nxstoryVariation', variantValue, 30 * 24);

				counter = card['timer'];
				Array.from(document.getElementsByClassName("btn-counter")).forEach(function(elem) {
					elem.innerHTML = counter;
				});

				Array.from(document.getElementsByClassName('btn-read-next')).forEach(function(elem) {
					elem.innerHTML = card['title'];
				});
				Array.from(document.getElementsByClassName('btn-next-text')).forEach(function(elem) {
					elem.innerHTML = card['linktext'];
				});
			}

			function initCounter(){
				if(variant == 0 || card == undefined){
					return;
				}
				let auxvariant = variant-1;
				if(document.getElementsByClassName('nxstory')[auxvariant]){
					const nxstoryViewEvent = new CustomEvent(
						'nxstoryView',
						{
							detail: {
								target: document.getElementsByClassName('nxstory')[auxvariant],
							}
						},
					);

					document.getElementsByClassName('nxstory')[auxvariant].style.bottom = '100px';
					dispatchEvent(nxstoryViewEvent);
				}

				if(auxvariant == 2 || auxvariant == 3){
					Array.from(document.getElementsByClassName("btn-progress")).forEach(function(elem) {
						elem.style.setProperty('background-color', '#FFFFFF');
					});
					Array.from(document.getElementsByClassName("btn-progress")).forEach(function(elem) {
						elem.style.setProperty('-webkit-animation', 'progressBar '+counter+'s linear');
					});
					Array.from(document.getElementsByClassName("btn-progress")).forEach(function(elem) {
						elem.style.setProperty('-moz-animation', 'progressBar '+counter+'s linear');
					});
					Array.from(document.getElementsByClassName("btn-progress")).forEach(function(elem) {
						elem.style.setProperty('-webkit-animation-fill-mode', 'both');
					});
					Array.from(document.getElementsByClassName("btn-progress")).forEach(function(elem) {
						elem.style.setProperty('-moz-animation-fill-mode', 'both');
					});

					myCounter = setInterval(function () {
						if(counter > 0){
							counter--;
							Array.from(document.getElementsByClassName("btn-counter")).forEach(function(elem) {
								elem.innerHTML = counter;
							});
							if(counter < 1){
								redirect(nxsurl);
								clearInterval(myCounter);
							}
						}
					}, 1000);
				}
			}

			function dismissNxsStory(){
				clearInterval(myCounter);
				Array.from(document.getElementsByClassName('nxstory')).forEach(function(elem) {
					elem.style.bottom='-100%';
					elem.style.display='none';
				});
				return false;
			}

			function redirect(url) {
				clicked = false;
				clicktype = '';
				function addParam(url, name) {
					newurl = new URL(url);
					newurl.searchParams.append(name, 1);
					return newurl.toString()
				}
				if(event){
					event.preventDefault();
				}
				if (getCookie('nxst-story-id') === "") {
					setCookie('nxst-story-id', current_id);
				}
				if(!url){
					if(event){
						clicked = true;
						nxstorycontainer = event.target.closest('[class*=nxstory-]');
						variant = nxstorycontainer.dataset.variant;
						if (variant.includes('auto')) {
							clicktype = 'auto'
						}
						url = event.target.closest("a").getAttribute('href');
					}
				}
				if (clicked) {
					if (clicktype === 'auto'){
						url = addParam(url, 'nxstory_autoturn_click')
					} else {
						url = addParam(url, 'nxstory_click')
					}
				} else {
					url = addParam(url, 'nxstory_autoturn')
				}
				window.location.href = url;
				return false;
			}
		</script>

