\"className\":\"StoryHero_heroGridImage__YqwzB\",\"decoding\":\"async\",\"height\":225,\"loading\":\"lazy\",\"src\":\"/resources/media2/16x9/727/400/16x0/80/5fc30441-b0e0-430a-99e8-bfd4931164b4-thumbnail_oldtentcity2.png\",\"width\":400}]]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"87:[\"$\",\"div\",null,{\"className\":\"StoryHero_caption__eOw9W\",\"children\":[\"$\",\"div\",null,{\"children\":\"Metro Council recently learned that the Strobel House, Nashville's first permanant housing for the homeless, had been operating without a contract.\"}]}]\n"])</script><script>self.__next_f.push([1,"88:[\"$\",\"div\",null,{\"className\":\"StoryPage_storyTextBlockContainer__LUkwY\",\"children\":[[\"$\",\"div\",null,{\"className\":\"StoryControls_controls__pSYQ_ StoryPage_controlsContainer__StRFl\",\"children\":[null,[\"$\",\"$L8c\",null,{\"className\":\"StoryPage_controlsContainer__StRFl\",\"commentCount\":1,\"fallback\":false,\"pageIndex\":0}],[\"$\",\"$L8d\",null,{\"buttonType\":\"Taskbar\",\"className\":\"StoryPage_controlsContainer__StRFl\",\"shareConfig\":{\"headline\":\"Metro Council calls out lack of oversight in contract lapse at homeless housing facility\",\"siteSlug\":\"fox17\",\"url\":\"https://fox17.com/news/local/metro-council-cites-lack-of-oversight-after-contract-lapse-at-homeless-housing-facility\"}}]]}],[\"$\",\"div\",null,{\"className\":\"StoryPage_contentColumnContainer__fMqAt\",\"children\":[[\"$\",\"div\",null,{\"className\":\"StoryPage_taboolaDeeperDive__WKVX7\",\"data-url\":\"https://fox17.com/news/local/metro-council-cites-lack-of-oversight-after-contract-lapse-at-homeless-housing-facility\",\"id\":\"deeper-dive-container-0\"}],[[\"$\",\"$L8e\",null,{\"className\":\"StoryPage_topicsContainer__YIZ_i\",\"topics\":[{\"name\":\"Oversight\",\"dimension\":\"AI Generated\",\"removable\":true,\"weight\":0.95,\"userGenerated\":false,\"source\":\"CHATGPT\"},{\"name\":\"Strobel House\",\"dimension\":\"AI Generated\",\"removable\":true,\"weight\":0.9,\"userGenerated\":false,\"source\":\"CHATGPT\"},{\"name\":\"Metro Council\",\"dimension\":\"AI Generated\",\"removable\":true,\"weight\":0.85,\"userGenerated\":false,\"source\":\"CHATGPT\"},{\"name\":\"Homeless services\",\"dimension\":\"AI Generated\",\"removable\":true,\"weight\":0.8,\"userGenerated\":false,\"source\":\"CHATGPT\"},{\"name\":\"Depaul USA\",\"dimension\":\"AI Generated\",\"removable\":true,\"weight\":0.7,\"userGenerated\":false,\"source\":\"CHATGPT\"},{\"name\":\"Contract lapse\",\"dimension\":\"AI Generated\",\"removable\":true,\"weight\":0.75,\"userGenerated\":false,\"source\":\"CHATGPT\"},{\"name\":\"Funding sources\",\"dimension\":\"AI Generated\",\"removable\":true,\"weight\":0.65,\"userGenerated\":false,\"source\":\"CHATGPT\"},{\"name\":\"Financial safeguards\",\"dimension\":\"AI Generated\",\"removable\":true,\"weight\":0.6,\"userGenerated\":false,\"source\":\"CHATGPT\"}]}],[\"$\",\"div\",null,{\"className\":\"StoryPage_divider__ZF7oD\"}]],[\"$\",\"div\",null,{\"className\":\"StoryText_storyText__C3hWI StoryText_storyText__C3hWI\",\"children\":[\"$\",\"div\",null,{\"children\":[[\"$\",\"p\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"dateline\",\"children\":\"NASHVILLE, Tenn. (WZTV) — \"}],\"Nashville’s first permanent supportive housing facility for people experiencing homelessness just marked its first anniversary, but with  it came a cloud of serious administrative oversight.\"]}],[\"$\",\"p\",null,{\"children\":[\"Metro Council recently learned that\",[\"$\",\"a\",null,{\"href\":\"https://www.youtube.com/watch?v=xh3P4yBZjr4\",\"target\":\"_blank\",\"children\":\" the Strobel House\"}],\", which currently houses and provides services for 90 residents, had been operating without a contract for nearly a year. The facility’s agreement with management company Depaul USA expired last September, according to Metro Department of Finance officals. But Metro’s Office of Homeless Services (OHS) continued payments through other funding sources, including vouchers, bypassing the finance department and reducing oversight.\"]}],\"$L8f\",\"$L90\",[\"$\",\"p\",null,{\"children\":\"“This is egregious. It shouldn’t have happened,” said Councilmember Zulfat Suara,  during Metro Council's last meeting on Aug. 19.\"}],\"$L91\",[\"$\",\"p\",null,{\"children\":\"“There’s a huge lack of oversight,” said Councilmember Ginny Welsch.\"}],[\"$\",\"p\",null,{\"children\":\"The lack of a formal agreement required Metro Council to take swift action. Council members approved a $3.5 million grant contract to keep the Strobel House operational. The first payment is set to go out this week, on Sept. 5. \"}],\"$L92\",[\"$\",\"p\",null,{\"children\":\"OHS Director April Calvin pointed to multiple contributing factors, including the complexity of the project, staffing turnover, and coordination across several Metro departments.\"}],[\"$\",\"p\",null,{\"children\":\"“The complexity of the problem... the complexity of the project. This was a one-of-a-kind for Metro, first-of-its-kind for our Office of Homeless Services,” Calvin said to Metro Council's Budget and Finance Committee. \"}],\"$L93\",\"$L94\",\"$L95\",\"$L96\",\"$L97\",\"$L98\",\"$L99\",\"$L9a\",\"$L9b\",\"$L9c\"]}]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"89:[\"$\",\"$L9d\",null,{\"storyIndex\":0,\"uuid\":\"7b52b505-4d38-4eae-a970-435c1f4dae5d\"}]\n"])</script><script>self.__next_f.push([1,"8a:[\"$\",\"div\",null,{\"className\":\"StickyTwoColumn_rightColumn__vCmRf\",\"children\":[\"$\",\"div\",null,{\"className\":\"StoryPage_rightColumn__t9tAM\",\"children\":[[\"$\",\"div\",null,{\"className\":\"Panel_panel__wT2cw\",\"id\":\"$undefined\",\"children\":[\"$\",\"$L82\",null,{\"fallback\":[\"$\",\"div\",null,{\"style\":{\"height\":681}}],\"showOn\":[\"XS\",\"S\",\"M\",\"L\",\"XL\"],\"children\":[\"$\",\"div\",null,{\"className\":\"RightRailPanelAd_noPanelSmall__7yQ1M Panel_panel__wT2cw\",\"id\":\"$undefined\",\"children\":[\"$\",\"$L83\",null,{\"adClassName\":\"RightRail\",\"adIndex\":0,\"adName\":\"rightrail_pos1\",\"pageType\":\"story\",\"tradehouseAttributionCanonicalUrl\":\"/metro-council-cites-lack-of-oversight-after-contract-lapse-at-homeless-housing-facility\"}]}]}]}],null,\"$L9e\",[\"$\",\"div\",null,{\"className\":\"StoryPage_bottomMobileAd__vek9s Panel_panel__wT2cw\",\"id\":\"$undefined\",\"children\":[\"$\",\"$L82\",null,{\"fallback\":[\"$\",\"div\",null,{\"style\":{\"height\":281}}],\"showOn\":[\"XS\",\"S\",\"M\",\"L\",\"XL\"],\"children\":[\"$\",\"div\",null,{\"className\":\"RightRailPanelAd_noPanelSmall__7yQ1M Panel_panel__wT2cw\",\"id\":\"$undefined\",\"children\":[\"$\",\"$L83\",null,{\"adClassName\":\"RightRailShort\",\"adIndex\":0,\"adName\":\"rightrail_pos2\",\"pageType\":\"story\",\"tradehouseAttributionCanonicalUrl\":\"/metro-council-cites-lack-of-oversight-after-contract-lapse-at-homeless-housing-facility\"}]}]}]}],null]}]}]\n"])</script><script>self.__next_f.push([1,"8b:[\"$\",\"div\",null,{\"className\":\"StoryPage_photoGalleryBarContainer__36YKT\",\"children\":\"$L9f\"}]\n"])</script><script>self.__next_f.push([1,"a0:I[79064,[\"6678\",\"static/chunks/6678-5a01322e785129d1.js\",\"8342\",\"static/chunks/8342-9eaa7895bea984c2.js\",\"1893\",\"static/chunks/1893-bab4d22b95356e80.js\",\"5413\",\"static/chunks/5413-13e24880fbed090b.js\",\"2275\",\"static/chunks/2275-12d355e450e0d251.js\",\"5604\",\"static/chunks/5604-d29d63070facff6c.js\",\"2008\",\"static/chunks/2008-d9ffd8d7407de74c.js\",\"483\",\"static/chunks/483-00552f9b0bc87775.js\",\"858\",\"static/chunks/858-49e627bfbe53a4aa.js\",\"1257\",\"static/chunks/1257-5566f6c77ce93d19.js\",\"983\",\"static/chunks/983-f5593a3ddcf052b2.js\",\"7731\",\"static/chunks/7731-93830645ddfc367c.js\",\"6225\",\"static/chunks/6225-a4d60842dfea7326.js\",\"406\",\"static/chunks/406-fc35008e755d3a9e.js\",\"8753\",\"static/chunks/8753-52b21cb1399e2572.js\",\"1312\",\"static/chunks/1312-5b1bdf666585fe67.js\",\"1330\",\"static/chunks/1330-3f9d5547f1b33447.js\",\"2206\",\"static/chunks/app/root/story-pages/news-story-page/page-43c9ae60d969caae.js\"],\"CommentCallToAction\"]\n"])</script><script>self.__next_f.push([1,"a1:I[84840,[\"6678\",\"static/chunks/6678-5a01322e785129d1.js\",\"8342\",\"static/chunks/8342-9eaa7895bea984c2.js\",\"1893\",\"static/chunks/1893-bab4d22b95356e80.js\",\"5413\",\"static/chunks/5413-13e24880fbed090b.js\",\"2275\",\"static/chunks/2275-12d355e450e0d251.js\",\"5604\",\"static/chunks/5604-d29d63070facff6c.js\",\"2008\",\"static/chunks/2008-d9ffd8d7407de74c.js\",\"483\",\"static/chunks/483-00552f9b0bc87775.js\",\"858\",\"static/chunks/858-49e627bfbe53a4aa.js\",\"1257\",\"static/chunks/1257-5566f6c77ce93d19.js\",\"983\",\"static/chunks/983-f5593a3ddcf052b2.js\",\"7731\",\"static/chunks/7731-93830645ddfc367c.js\",\"6225\",\"static/chunks/6225-a4d60842dfea7326.js\",\"406\",\"static/chunks/406-fc35008e755d3a9e.js\",\"8753\",\"static/chunks/8753-52b21cb1399e2572.js\",\"1312\",\"static/chunks/1312-5b1bdf666585fe67.js\",\"1330\",\"static/chunks/1330-3f9d5547f1b33447.js\",\"2206\",\"static/chunks/app/root/story-pages/news-story-page/page-43c9ae60d969caae.js\"],\"BufferedDisplayAd\"]\n"])</script><script>self.__next_f.push([1,"a2:I[2910,[\"6678\",\"static/chunks/6678-5a01322e785129d1.js\",\"8342\",\"static/chunks/8342-9eaa7895bea984c2.js\",\"1893\",\"static/chunks/1893-bab4d22b95356e80.js\",\"5413\",\"static/chunks/5413-13e24880fbed090b.js\",\"2275\",\"static/chunks/2275-12d355e450e0d251.js\",\"5604\",\"static/chunks/5604-d29d63070facff6c.js\",\"2008\",\"static/chunks/2008-d9ffd8d7407de74c.js\",\"483\",\"static/chunks/483-00552f9b0bc87775.js\",\"858\",\"static/chunks/858-49e627bfbe53a4aa.js\",\"1257\",\"static/chunks/1257-5566f6c77ce93d19.js\",\"983\",\"static/chunks/983-f5593a3ddcf052b2.js\",\"7731\",\"static/chunks/7731-93830645ddfc367c.js\",\"6225\",\"static/chunks/6225-a4d60842dfea7326.js\",\"406\",\"static/chunks/406-fc35008e755d3a9e.js\",\"8753\",\"static/chunks/8753-52b21cb1399e2572.js\",\"1312\",\"static/chunks/1312-5b1bdf666585fe67.js\",\"1330\",\"static/chunks/1330-3f9d5547f1b33447.js\",\"2206\",\"static/chunks/app/root/story-pages/news-story-page/page-43c9ae60d969caae.js\"],\"PrimisMidArticleAdUnit\"]\n"])</script><script>self.__next_f.push([1,"93:[\"$\",\"p\",null,{\"children\":\"But not everyone was satisfied with the explanation.\"}]\n94:[\"$\",\"p\",null,{\"children\":\"“I'm looking for who can take over the finances of this whole thing because we are out of order,” said Mike Lacy, who spoke during the meeting's public comment period. \"}]\n95:[\"$\",\"p\",null,{\"children\":\"“This is not at all a unique situation with OHS. We have found errors in contracts, math errors- things we’ve had to correct,” Welsch said.\"}]\n96:[\"$\",\"p\",null,{\"children\":\"In response to the oversight, OHS outlined steps it’s taking to prevent issues in the future, including hiring a dedicated contract administrator, increasing training for employees, and improving interdepartmental coordination and tracking.\"}]\n97:[\"$\",\"p\",null,{\"children\":\"“I think this points to some very fundamental flaws in how we are doing our finance and oversight within Metro,” Welsch said. \"}]\n98:[\"$\",\"p\",null,{\"children\":\"The situation has raised broader concerns about whether Metro Nashville needs stronger financial safeguards across departments.\"}]\n99:[\"$\",\"p\",null,{\"children\":\"The Strobel House has operated for more than a year, helping Nashville transition people without housing to more permanent stability. OHS reported some residents have enrolled or graduated from college since joining the center. Others have celebrated months sober. \"}]\n9b:[\"$\",\"$La0\",null,{\"canonicalUrl\":\"\",\"commentingActive\":false,\"numberComments\":1,\"pageIndex\":0,\"platform\":\"desktop\"}]\n9c:[\"$\",\"p\",null,{\"children\":\"In the last two years, OHS reported it moved 3,868 people in Nashville from homelessness to housing. \"}]\n8f:[\"$\",\"$L82\",null,{\"showOn\":[\"M\",\"L\",\"XL\",\"S\"],\"children\":[\"$\",\"div\",null,{\"className\":\"MidArticleAdUnit_desktop__8V4OI\",\"children\":[\"$\",\"$La1\",null,{\"adIndex\":0,\"adName\":\"interstory_first\",\"minHeight\":250,\"pageType\":\"story\",\"placement\":\"mid-article platform=desktop\",\"tradehouseAttributionCanonicalUrl\":\"/metro-council-cites-lack-of-oversight-after-contract-lapse-at-homeless-housing-facility\",\"viewportBufferedAds\":{\"e"])</script><script>self.__next_f.push([1,"nabled\":false}}]}]}]\n90:[\"$\",\"$L82\",null,{\"showOn\":[\"XS\"],\"children\":[\"$\",\"div\",null,{\"className\":\"MidArticleAdUnit_mobile__mXvRB MidArticleAdUnit_mobileDisplayAdReserve__C7csM\",\"children\":[\"$\",\"$La1\",null,{\"adIndex\":0,\"adName\":\"interstory_first\",\"minHeight\":250,\"pageType\":\"story\",\"placement\":\"mid-article platform=mobile\",\"tradehouseAttributionCanonicalUrl\":\"/metro-council-cites-lack-of-oversight-after-contract-lapse-at-homeless-housing-facility\",\"viewportBufferedAds\":\"$8f:props:children:props:children:props:viewportBufferedAds\"}]}]}]\n91:[\"$\",\"$La2\",null,{\"platform\":\"mobile\",\"storyIndex\":0}]\n92:[\"$\",\"$La2\",null,{\"platform\":\"desktop\",\"storyIndex\":0}]\n"])</script><script>self.__next_f.push([1,"9a:[\"$\",\"$L82\",null,{\"showOn\":[\"XS\"],\"children\":[\"$\",\"div\",null,{\"className\":\"MidArticleAdUnit_mobile__mXvRB MidArticleAdUnit_mobileDisplayAdReserve__C7csM\",\"children\":[\"$\",\"$La1\",null,{\"adIndex\":0,\"adName\":\"interstory_second\",\"minHeight\":250,\"pageType\":\"story\",\"placement\":\"mid-article platform=mobile\",\"tradehouseAttributionCanonicalUrl\":\"/metro-council-cites-lack-of-oversight-after-contract-lapse-at-homeless-housing-facility\",\"viewportBufferedAds\":\"$8f:props:children:props:children:props:viewportBufferedAds\"}]}]}]\n"])</script><script>self.__next_f.push([1,"a3:I[54188,[\"6678\",\"static/chunks/6678-5a01322e785129d1.js\",\"8342\",\"static/chunks/8342-9eaa7895bea984c2.js\",\"1893\",\"static/chunks/1893-bab4d22b