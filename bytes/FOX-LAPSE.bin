Layer || [];\n        window.dataLayer.push({\n            event: \"experiment_assignment\",\n            experiment_name: assignment.name,\n            experiment_variant: assignment.variant\n        });\n    }\n}());","id":"deeper-dive-experiment-tracking"}])</script><script>(self.__next_s=self.__next_s||[]).push([0,{"children":"(function () {\n    var assignment = {\"name\":\"Story Collapsed Comments iOS\",\"variant\":\"control\"};\n    var assignments = Array.isArray(window.ldExperiments) ? window.ldExperiments : [];\n    var existingIndex = assignments.findIndex(function (item) {\n        return item.name === assignment.name;\n    });\n    var isNewAssignment = existingIndex === -1\n        || assignments[existingIndex].variant !== assignment.variant;\n\n    if (existingIndex === -1) {\n        assignments.push(assignment);\n    } else {\n        assignments[existingIndex] = assignment;\n    }\n\n    window.ldExperiments = assignments;\n    window.ldExpName = assignment.name;\n    window.ldExpVar = assignment.variant;\n\n    if (isNewAssignment) {\n        window.dataLayer = window.dataLayer || [];\n        window.dataLayer.push({\n            event: \"experiment_assignment\",\n            experiment_name: assignment.name,\n            experiment_variant: assignment.variant\n        });\n    }\n}());","id":"collapsed-comments-ios-experiment-tracking"}])</script><script id="story-json-ld" type="application/ld+json">{"@context":"https://schema.org","@type":"NewsArticle","author":{"@type":"Person","name":"Kelly Avellino"},"description":"Metro Council recently learned that the Strobel House, Nashville's first permanant housing for the homeless, had been operating without a contract.","headline":"Metro Council calls out lack of oversight in contract lapse at homeless housing facility","publisher":{"@type":"Organization","name":"WZTV","logo":{"@type":"ImageObject","url":"https://fox17.com/resources/assets/wztv/images/logos/wztv_logo_w.svg"}},"speakable":{"@type":"SpeakableSpecification","xpath":["//div[contains(@class, 'StoryText_storyText')]//p"]},"thumbnailUrl":"https://fox17.com/resources/media2/16x9/659/1320/5x0/90/d977c72b-77ad-450a-8212-a507f1385696-strobel.JPG","wordCount":406,"image":[{"@type":"ImageObject","caption":"Metro Council recently learned that the Strobel House, Nashville's first permanant housing for the homeless, had been operating without a contract.","url":"https://fox17.com/resources/media2/16x9/659/1320/5x0/90/d977c72b-77ad-450a-8212-a507f1385696-strobel.JPG","width":"659","height":"371"},{"@type":"ImageObject","caption":"Metro Council recently learned that the Strobel House, Nashville's first permanant housing for the homeless, had been operating without a contract.","url":"https://fox17.com/resources/media2/1x1/371/1440/149x0/90/d977c72b-77ad-450a-8212-a507f1385696-strobel.JPG","width":"371","height":"371"},{"@type":"ImageObject","caption":"Metro Council recently learned that the Strobel House, Nashville's first permanant housing for the homeless, had been operating without a contract.","url":"https://fox17.com/resources/media/6137908a-3f73-45cf-a144-83cf7f35821f-jumbo16x9_strobelhouse1.PNG","width":"895","height":"503"},{"@type":"ImageObject","caption":"Metro Council recently learned that the Strobel House, Nashville's first permanant housing for the homeless, had been operating without a contract.","url":"https://fox17.com/resources/media/6137908a-3f73-45cf-a144-83cf7f35821f-jumbo1x1_strobelhouse1.PNG","width":"511","height":"511"},{"@type":"ImageObject","caption":"Metro Council recently learned that the Strobel House, Nashville's first permanant housing for the homeless, had been operating without a contract.","url":"https://fox17.com/resources/media2/16x9/659/1320/5x0/90/d977c72b-77ad-450a-8212-a507f1385696-strobel.JPG","width":"659","height":"371"},{"@type":"ImageObject","caption":"Metro Council recently learned that the Strobel House, Nashville's first permanant housing for the homeless, had been operating without a contract.","url":"https://fox17.com/resources/media2/1x1/371/1440/149x0/90/d977c72b-77ad-450a-8212-a507f1385696-strobel.JPG","width":"371","height":"371"},{"@type":"ImageObject","caption":"Metro Council recently learned that the Strobel House, Nashville's first permanant housing for the homeless, had been operating without a contract.","url":"https://fox17.com/resources/media2/16x9/727/1320/16x0/90/5fc30441-b0e0-430a-99e8-bfd4931164b4-thumbnail_oldtentcity2.png","width":"727","height":"409"},{"@type":"ImageObject","caption":"Metro Council recently learned that the Strobel House, Nashville's first permanant housing for the homeless, had been operating without a contract.","url":"https://fox17.com/resources/media2/1x1/409/1440/175x0/90/5fc30441-b0e0-430a-99e8-bfd4931164b4-thumbnail_oldtentcity2.png","width":"409","height":"409"}],"mainEntityOfPage":{"@id":"https://fox17.com/news/local/metro-council-cites-lack-of-oversight-after-contract-lapse-at-homeless-housing-facility","@type":"WebPage","name":"Metro Council calls out lack of oversight in contract lapse at homeless housing facility"},"url":"https://fox17.com/news/local/metro-council-cites-lack-of-oversight-after-contract-lapse-at-homeless-housing-facility","articleBody":"Nashville’s first permanent supportive housing facility for people experiencing homelessness just marked its first anniversary, but with it came a cloud of serious administrative oversight. Metro Council recently learned that the Strobel House , which currently houses and provides services for 90 residents, had been operating without a contract for nearly a year. The facility’s agreement with management company Depaul USA expired last September, according to Metro Department of Finance officals. But Metro’s Office of Homeless Services (OHS) continued payments through other funding sources, including vouchers, bypassing the finance department and reducing oversight. &ldquo;This is egregious. It shouldn’t have happened,&rdquo; said Councilmember Zulfat Suara, during Metro Council's last meeting on Aug. 19. &ldquo;There’s a huge lack of oversight,&rdquo; said Councilmember Ginny Welsch. The lack of a formal agreement required Metro Council to take swift action. Council members approved a $3.5 million grant contract to keep the Strobel House operational. The first payment is set to go out this week, on Sept. 5. OHS Director April Calvin pointed to multiple contributing factors, including the complexity of the project, staffing turnover, and coordination across several Metro departments. &ldquo;The complexity of the problem... the complexity of the project. This was a one-of-a-kind for Metro, first-of-its-kind for our Office of Homeless Services,&rdquo; Calvin said to Metro Council's Budget and Finance Committee. But not everyone was satisfied with the explanation. &ldquo;I'm looking for who can take over the finances of this whole thing because we are out of order,&rdquo; said Mike Lacy, who spoke during the meeting's public comment period. &ldquo;This is not at all a unique situation with OHS. We have found errors in contracts, math errors- things we’ve had to correct,&rdquo; Welsch said. In response to the oversight, OHS outlined steps it’s taking to prevent issues in the future, including hiring a dedicated contract administrator, increasing training for employees, and improving interdepartmental coordination and tracking. &ldquo;I think this points to some very fundamental flaws in how we are doing our finance and oversight within Metro,&rdquo; Welsch said. The situation has raised broader concerns about whether Metro Nashville needs stronger financial safeguards across departments. The Strobel House has operated for more than a year, helping Nashville transition people without housing to more permanent stability. OHS reported some residents have enrolled or graduated from college since joining the center. Others have celebrated months sober. In the last two years, OHS reported it moved 3,868 people in Nashville from homelessness to housing.","articleSection":"Local","keywords":"contract lapse, news, oversight, financial safeguards, metro council, funding sources, depaul usa, strobel house, newsletter daily, homeless services, local","dateModified":"2025-08-31T22:08:07.000-05:00","datePublished":"2025-08-31T22:08:07.000-05:00","video":{"@type":"VideoObject","embedUrl":"https://harvest-media-clips.sinclairstoryline.com/WZTV/2025-09-01T03:05:31.172Z/Live-DVR/37953eaf-8bef-48a9-bb91-e39ccb2cbf29/mp4/index.mp4","name":"WZTV","duration":"PT1M39S","description":"Metro Council recently learned that the Strobel House, Nashville's first permanant housing for the homeless, had been operating without a contract.","thumbnailUrl":"https://harvest-media-clips.sinclairstoryline.com/WZTV/2025-09-01T03:05:31.172Z/Live-DVR/37953eaf-8bef-48a9-bb91-e39ccb2cbf29/thumbnails/000005.jpg","uploadDate":"2025-08-31T22:08:07.000-05:00"}}</script><div id="main-content"><div><div class="InfiniteScroll_container__7G7pl"><div style="position:relative;z-index:1"><div class="StoryPage_storyPage__JhcXf" data-story-analytic-data="{&quot;article_name&quot;:&quot;Metro Council calls out lack of oversight in contract lapse at homeless housing facility&quot;,&quot;article_pos&quot;:&quot;page_0&quot;,&quot;article_sections&quot;:[&quot;news&quot;,&quot;local&quot;],&quot;article_tags&quot;:[&quot;Oversight&quot;,&quot;Strobel House&quot;,&quot;Metro Council&quot;,&quot;Homeless services&quot;,&quot;Depaul USA&quot;,&quot;Contract lapse&quot;,&quot;Funding sources&quot;,&quot;Financial safeguards&quot;],&quot;article_uuid&quot;:&quot;7b52b505-4d38-4eae-a970-435c1f4dae5d&quot;,&quot;author_name&quot;:&quot;Kelly Avellino&quot;,&quot;publish_date&quot;:&quot;2025-08-31T22:08:07.000-05:00&quot;,&quot;syndicated_paths&quot;:[],&quot;served_from&quot;:&quot;direct&quot;}" data-story-focus="Oversight" data-story-title="Metro Council calls out lack of oversight in contract lapse at homeless housi