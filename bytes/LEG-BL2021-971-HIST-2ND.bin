				<td valign="top" style="width: 150px">
                        <span id="ctl00_ContentPlaceHolder1_lblTitlePrompt"><font face="Tahoma" color="Navy" size="2">Title:</font></span>
                    </td>
				<td valign="top">
                        <span id="ctl00_ContentPlaceHolder1_lblTitle"><font face="Tahoma" color="Black" size="2">An ordinance to amend Title 2 of the Metropolitan Code of Laws to create an Office Homeless Services.</font></span>
                    </td>
			</tr>
