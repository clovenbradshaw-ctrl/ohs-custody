				<td valign="top" style="width: 150px">
                        <span id="ctl00_ContentPlaceHolder1_lblActionPrompt"><font face="Tahoma" color="Navy" size="2">Action:</font></span>
                    </td>
				<td valign="top">
                        <span id="ctl00_ContentPlaceHolder1_lblAction"><font face="Tahoma" color="Black" size="2">passed on second reading as amended</font></span>
                    </td>
			</tr>
		</table>
		
            <table id="ctl00_ContentPlaceHolder1_tblActionText" border="0" cellpadding="2" cellspacing="2" width="100%">
			<tr>
				<td valign="top" style="width: 150px">
                        <span id="ctl00_ContentPlaceHolder1_lblActionTextPrompt"><font face="Tahoma" color="Navy" size="2">Action text:</font></span>
                    </td>
				<td valign="top">
                        <span id="ctl00_ContentPlaceHolder1_lblActionText"><font face="Tahoma" color="Black" size="2">Council Member O'Connell offered Amendment No. 1 and moved that it be adopted, which motion was seconded and approved by a voice vote of the Council. Council Member O'Connell moved to pass the bill on second reading as amended, which motion was seconded and approved by a voice vote of the Council.</font></span>
                    </td>
			</tr>
		</table>
		
        
