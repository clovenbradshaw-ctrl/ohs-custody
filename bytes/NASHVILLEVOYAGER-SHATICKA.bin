<script>

const mainNav = document.querySelector('#main-nav-wrap');
const sentinel = document.querySelector('#site-header'); // element ABOVE the sticky nav

const observer = new IntersectionObserver(([entry]) => {
    if (!entry.isIntersecting) {
        // Original nav is out of view — show sticky
        mainNav.classList.add('main-nav-drop');
    } else {
        // Original nav is visible — hide sticky
        mainNav.classList.remove('main-nav-drop');
    }
}, {
    threshold: 0
});

observer.observe(sentinel);
	
	
	

	
</script>


<script>

jQuery(document).ready(function ($) {
  var $h1 = $('h1.sr-only').first();

  if (!$h1.length) return;

  // Check if already inside a landmark
  var alreadyInLandmark = $h1.closest(
    'main, [role="main"], header, [role="banner"], ' +
    'nav, [role="navigation"], aside, [role="complementary"]'
  ).length;

  if (!alreadyInLandmark) {
    // Wrap it in a visually hidden <header> landmark
    // so SR users can find it via landmark navigation
    $h1.wrap('<div></div>');
  }

  // If a <main> landmark exists but has no heading,
  // move the h1 inside main so it labels the page content
  var $main = $('main, [role="main"]').first();
  if ($main.length && !$main.find('h1').length) {
    $main.prepend($h1);
  }

});

</script>

<script>

jQuery(document).ready(function ($) {

  var $h1 = $('h1.sr-only').first();
  if (!$h1.length) return;

  var $parentDiv = $h1.parent('div');

  // ── Check if already inside a landmark ────────────────────────────────────
  var alreadyInLandmark = $h1.closest(
    'main, [role="main"], ' +
    'header, [role="banner"], ' +
    'footer, [role="contentinfo"], ' +
    'nav, [role="navigation"], ' +
    'aside, [role="complementary"], ' +
    'section[aria-label], section[aria-labelledby], [role="region"]'
  ).length;

  if (alreadyInLandmark) return; // already fine, nothing to do

  // ── Best practice: move h1 into <main> as its first child ─────────────────
  // h1 describes the page — it belongs at the top of the main landmark
  var $main = $('main, [role="main"]').first();

  if ($main.length) {
    // Move just the h1 into main, leave the empty div behind and remove it
    $main.prepend($h1);
    if ($parentDiv.length && $parentDiv.children().length === 0) {
      $parentDiv.remove(); // clean up the now-empty wrapper div
    }

  } else {
    // ── No <main> exists — promote the parent div to a main landmark ─────────
    // Do NOT add role="main" if a <main> element exists elsewhere
    if (!$('main').length) {
      $parentDiv
        .attr('role', 'main')
        .attr('aria-label', $h1.text().trim() || 'Main content');
    }
  }

});
</script>		<style>
