/* ADA Implementation Code */

a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible, select:focus-visible, 
.fly-to-top.back-to-top:focus-visible, .fly-but-wrap:focus-visible {
  outline: 2px solid #FF2E96  !important; 
	outline-offset: 3px;
}

/* 
.horz-list-head.left.relative h3{background-color: #333333 }
*/

.archive-list-share a:focus-visible {
 outline: none;
  box-shadow: 0 0 0 2px #000;
}

#back-to-top-btn {display:none !important}

i.fa.fa-rss.fa-2 {
    margin-bottom: 65px;
}

.foot-info-text.left.relative, .foot-head, .foot-copy.relative p {color: #757575 !important}

/* error styling start */




.post-template-default #main-nav-wrap {
  display: block !important;
}

.interview-template-default #main-nav-wrap {
  display: block !important;
}

@media (max-width: 768px) {
    #main-nav-wrap {
        display: block !important;
    }
}


#main-nav-wrap.main-nav-drop {
  display: block; 
}

#main-nav-wrap {
  display: none;
} 


 

.error {
  border: 2px solid #d93025;
}

.error-message {
  display: block;
  color: #d93025;
  font-size: 14px;
  margin-top: 6px;
}

/* error styling end */

.post-soc-twit {background-color: #007FAD !important }

.content-main.left.relative a {color: #007FAD ; text-decoration: underline} 

.comment-reply a {
	color: white !important;
	font-size: 14px !important;
	background-color: #E60073 !important}

.comment-form label {color: #757575 !important}

.required {color: #E61B00 !important}

.archive-list-text.left.relative p, .post-date time {
  color: #707070 !important;
}

.archive-list-cat.left, 
.post-cat a, .post-tags-header {
  color: #E60073 !important;
}

.home-widget-head {color: #949494 !important}

.pagination span, .pagination a {background : #757575 }

.pagination .current, .pagination a:hover {background : #000 } 


/* ADA Implementation Code End */

.author-name {
    color: #333333 !important;
}
</style>

