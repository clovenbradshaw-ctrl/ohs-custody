<link rel="https://api.w.org/" href="https://nashvillevoyager.com/wp-json/" /><link rel="alternate" title="JSON" type="application/json" href="https://nashvillevoyager.com/wp-json/wp/v2/interview/177817" /><link rel="EditURI" type="application/rsd+xml" title="RSD" href="https://nashvillevoyager.com/xmlrpc.php?rsd" />

<link rel="canonical" href="https://nashvillevoyager.com/interview/community-highlights-meet-shaticka-robinson-of-coleys-jook-junt-food-truck-bougie-barbecue-brand/" />
<link rel='shortlink' href='https://nashvillevoyager.com/?p=177817' />
<!-- start Simple Custom CSS and JS -->
<script type="text/javascript">
jQuery(document).ready(function() {
	console.log("test header O JS code");
	jQuery('a:contains("Ask a question!")').attr('aria-label', 'Ask a question!');
	jQuery('a .icon-yelp').parent('a').attr('aria-label', "Visit Benny's Tacos on Yelp (opens in new tab)");
    // Select both elements. The comma acts as an OR selector.
    // Select all potential content containers across different templates
    // This targets the specific children of #content-in
	var contentToWrap = $('#content-in').children('#head-main-top, .sec-marg-out, #main-content-wrap');
    // Only wrap if these elements are found to avoid empty <main> tags
    if (contentToWrap.length > 0) {
        contentToWrap.wrapAll('<main id="main" role="main"></main>');
    }
 	var $button = $('.fly-but-wrap');
    var $menu = $('#fly-menu-wrap');

    // 1. Initialize attributes for accessibility
    $button.attr({
        'role': 'button',
        'tabindex': '0',
        'aria-label': 'Open Menu',
        'aria-expanded': 'false',
        'aria-controls': 'fly-menu-wrap'
    });

    // 2. Click Handler (Toggle Logic)
    $button.on('click', function() {
        var isOpen = $(this).attr('aria-expanded') === 'true';
        var nextState = !isOpen;
        
        // UPDATE: Toggle aria-label instead of changing inner span text
        $(this).attr({
            'aria-expanded': nextState,
            'aria-label': nextState ? 'Close Menu' : 'Open Menu'
        });
        
        if (nextState) {
            $menu.addClass('is-open'); 
            // Focus the first item in the menu
            $menu.find('a, button').first().focus();
        } else {
            $menu.removeClass('is-open');
        }
    });

    // 3. Trigger Click on "Enter" key
    $button.on('keydown', function(e) {
        if (e.which === 13) { // Enter key
            e.preventDefault();
            $(this).trigger('click');
        }
    });

    // 4. Escape Key to Close
    $(document).on('keydown', function(e) {
        if (e.which === 27 && $button.attr('aria-expanded') === 'true') { // Esc key
            $button.trigger('click').focus();
        }
    });

    // 5. Focus Trap - IMPROVED
    $menu.add($button).on('keydown', function(e) {
        if (e.which !== 9) return; // Only Tab key

        // UPDATE: Only trap focus if the menu is actually open
        var isOpen = $button.attr('aria-expanded') === 'true';
        if (!isOpen) return; 

        var $focusableElements = $menu.find('a, button, input, [tabindex="0"]').add($button);
        var $first = $focusableElements.first();
        var $last = $focusableElements.last();

        if (e.shiftKey) { // Tab backwards (Shift + Tab)
            if (document.activeElement === $first[0]) {
                e.preventDefault();
                $last.focus();
            }
        } else { // Tab forwards (Tab)
            if (document.activeElement === $last[0]) {
                e.preventDefault();
                $first.focus();
            }
        }
    });
	$(".archive-list-img > a").attr("aria-hidden","true").attr("tabindex","-1")
	$('.archive-list-info').each(function() {
        var $container = $(this);

        // 2. Change the <div> to a <ul> and add accessibility labels
        $container.replaceWith(function() {
            return $('<ul/>', {
                class: $container.attr('class'), // Keep original classes (left, relative, etc)
                'aria-label': 'Post metadata',
                html: $container.html()
            });
        });
    });

    // 3. Re-select the new <ul> elements to wrap the spans
    $('ul.archive-list-info').each(function() {
        // Wrap each direct child span in an <li>
        $(this).children('span').each(function() {
            // Add a hidden comma inside the span for screen reader pauses
            $(this).append('<span class="screen-reader-text">,</span>');
            // Wrap the span in an <li>
            $(this).wrap('<li class="left"></li>');
        });
    });
	
//=======================Back to top button start //=======================//=======================

$(document).ready(function() {
    var $backToTop = $('.fly-to-top.back-to-top').detach();
    
    $('body').append($backToTop);
    
    $backToTop.css({
        'position': 'fixed',
        'bottom': '0',
        'right': '0',
        'z-index': '9999'
    });
    
    $backToTop.attr({
        'tabindex': '0',
        'role': 'button',
        'aria-label': 'Back to top'
    });

    // Click handler
    $backToTop.on('click', function() {
        $('html, body').animate({ scrollTop: 0 }, 'smooth');
    });

    // Keyboard handler - Enter and Space both trigger scroll
    $backToTop.on('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            $('html, body').animate({ scrollTop: 0 }, 'smooth');
        }
    });
});
	
	
	
	const $footer = $('#foot-wrap');
    const $btn = $('<button id="back-to-top-btn" aria-label="Back to top"><i class="fa fa-angle-up fa-3" aria-hidden="true"></i></button>');
    $footer.append($btn);
	
	
	
  var $toTop = jQuery('.fly-to-top.back-to-top');

  if ($toTop.length && jQuery('footer').length) {
    $toTop.appendTo('footer');
  }
	
	
	
//======================= Back to top button end //=======================//=======================
	

    // Target element to focus at the top
    const $topTarget = $('header').length ? $('#main-header') : $('body');

    // Ensure the target is focusable
    $topTarget.attr('tabindex', '-1');

    // Click handler
    $btn.on('click', function () {
		$('html, body').animate({ scrollTop: 0 }, 400, function () {
			$topTarget.focus();
		});
	});
	
	
	$("#searchform input").attr("aria-label","Search Site");
	$('.theiaPostSlider_slides p a').each(function() {
        var $link = $(this);
        
        // 2. Find the person's name 
        // We look for the h2 element immediately preceding the current paragraph
        var personName = $link.closest('p').prev('h2').text().trim();

        // 3. If a name is found, apply the descriptive aria-label
        if (personName) {
            $link.attr('aria-label', 'Read more about ' + personName);
        }
    });
	var $moderationMsg = $('.waiting_approval');

    if ($moderationMsg.length > 0) {
        // 2. Create the announcer element dynamically
        var $announcer = $('<div id="comment-announcer"></div>').css({
            'position': 'absolute',
            'width': '1px',
            'height': '1px',
            'padding': '0',
            'margin': '-1px',
            'overflow': 'hidden',
            'clip': 'rect(0, 0, 0, 0)',
            'white-space': 'nowrap',
            'border': '0'
        }).attr({
            'aria-live': 'assertive',
            'aria-atomic': 'true',
			'role':'alert'
        });

        // 3. Append it to the body
        $('body').append($announcer);

        // 4. Set the success message after a short delay
        // (A small delay ensures the screen reader registers the live region first)
        setTimeout(function() {
            var successNotice = "Your comment has been submitted successfully and is awaiting for admin approval.";
            $announcer.text(successNotice);
        }, 500);
        
        // 5. Scroll to the moderation notice so the user knows where they are
        $('html, body').animate({
            scrollTop: $moderationMsg.offset().top - 150
        }, 600);
    }
});
</script>
<!-- end Simple Custom CSS and JS -->
