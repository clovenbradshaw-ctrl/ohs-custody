<script> 
// jQuery(function ($) {

//   // run only on homepage
//   if (window.location.pathname === '/' ||
//       $('body').hasClass('home')) {

//     var pageTitle = document.title;

//     // prevent duplicate H1
//     if ($('h1.page-title-hidden').length === 0) {

