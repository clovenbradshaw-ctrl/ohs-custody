            <title data-rh="true">Another $1.5M without accounting for the last $4.4M | What happens when homelessness is managed like a product line &amp; funded like a slush fund </title>
            
            <meta data-rh="true" name="theme-color" content="#fafafa"/><meta data-rh="true" property="og:type" content="article"/><meta data-rh="true" property="og:title" content="Another $1.5M without accounting for the last $4.4M | What happens when homelessness is managed like a product line &amp; funded like a slush fund "/><meta data-rh="true" name="twitter:title" content="Another $1.5M without accounting for the last $4.4M | What happens when homelessness is managed like a product line &amp; funded like a slush fund "/><meta data-rh="true" name="description" content="Nashville handed homelessness to a well connected executive who oversaw the merger of stolen foreign data grown into a $22.1 ICE contract. The results? No looking looking good."/><meta data-rh="true" property="og:description" content="Nashville handed homelessness to a well connected executive who oversaw the merger of stolen foreign data grown into a $22.1 ICE contract. The results? No looking looking good."/><meta data-rh="true" name="twitter:description" content="Nashville handed homelessness to a well connected executive who oversaw the merger of stolen foreign data grown into a $22.1 ICE contract. The results? No looking looking good."/><meta data-rh="true" property="og:image" content="https://substackcdn.com/image/fetch/$s_!pGvE!,w_1200,h_675,c_fill,f_jpg,q_auto:good,fl_progressive:steep,g_auto/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fedda13e1-a10c-43a6-b8ef-243d815b8d0a_1010x264.png"/><meta data-rh="true" name="twitter:image" content="https://substackcdn.com/image/fetch/$s_!EKSL!,f_auto,q_auto:best,fl_progressive:steep/https%3A%2F%2Freadrichtext.substack.com%2Fapi%2Fv1%2Fpost_preview%2F189807971%2Ftwitter.jpg%3Fversion%3D4"/><meta data-rh="true" name="twitter:card" content="summary_large_image"/><meta data-rh="true" property="article:modified_time" content="2026-03-04T16:37:06.726Z"/>
            
            
        

        

