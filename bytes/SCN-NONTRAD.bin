                    <a href="/news/coverstory/rebecca-higgins-nashville-history-famous-madam/article_126fe3a9-0c8f-4dc1-9e98-2c181a6bbd55.html" class="tnt-asset-link"  aria-label="Rebecca Higgins: Nashville’s Queen of the Demimonde">
                
                
                
                
                        <img
                            src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAQAAACRI2S5AAAAEklEQVR42mM8U8+AFzCOKgADAHdUC60wg0dkAAAAAElFTkSuQmCC"
