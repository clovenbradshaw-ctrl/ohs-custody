                        <div class="media-preview-126fe3a9-0c8f-4dc1-9e98-2c181a6bbd55 media-preview article-asset " data-aspect="16:9"><figure class="photo layout-horizontal letterbox-style-default">
            <div class="image" 
                    data-toggle="modal"
                    
