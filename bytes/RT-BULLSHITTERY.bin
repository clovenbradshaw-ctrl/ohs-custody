,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fb0e1df60-e27a-4eba-80d8-cf1082cf8d0d_500x500.png","contentUrl":"https://substackcdn.com/image/fetch/$s_!SAwm!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fb0e1df60-e27a-4eba-80d8-cf1082cf8d0d_500x500.png","thumbnailUrl":"https://substackcdn.com/image/fetch/$s_!SAwm!,w_128,h_128,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fb0e1df60-e27a-4eba-80d8-cf1082cf8d0d_500x500.png"}},"interactionStatistic":[{"@type":"InteractionCounter","interactionType":"https://schema.org/LikeAction","userInteractionCount":1},{"@type":"InteractionCounter","interactionType":"https://schema.org/ShareAction","userInteractionCount":1},{"@type":"InteractionCounter","interactionType":"https://schema.org/CommentAction","userInteractionCount":0}]}</script><script nonce="ieRPUMD1eg2G1PLEgUt7Yw" type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"{Rich Text}","item":"https://readrichtext.substack.com"},{"@type":"ListItem","position":2,"name":"Liberal Bullshittery: An Autopsy of a Democracy","item":"https://readrichtext.substack.com/p/liberal-bullshittery-an-autopsy-of"}]}</script><div aria-label="Post" role="main" class="single-post-container"><div class="container"><div class="single-post"><div class="pencraft pc-display-contents pc-reset pubTheme-yiXxQA"><article class="typography newsletter-post post"><div role="region" aria-label="Post header" class="post-header"><h1 dir="auto" class="post-title published title-X77sOw">Liberal Bullshittery: An Autopsy of a Democracy</h1><h3 dir="auto" class="subtitle subtitle-HEEcLo">What a Nashville budget hearing reveals about how progressive cities build the infrastructure for authoritarian capture — one sole-source contract at a time.</h3><div aria-label="Post UFI" role="region" class="pencraft pc-display-flex pc-flexDirection-column pc-paddingBottom-16 pc-reset"><div class="pencraft pc-display-flex pc-paddingTop-16 pc-paddingBottom-16 pc-justifyContent-space-between pc-alignItems-center pc-reset"><div class="pencraft pc-display-flex pc-gap-12 pc-alignItems-center pc-reset byline-wrapper"><div class="pencraft pc-display-flex pc-reset"><div class="pencraft pc-display-flex pc-flexDirection-row pc-gap-8 pc-alignItems-center pc-justifyContent-flex-start pc-reset"><div style="--scale:36px;--offset:9px;--border-width:4.5px;" class="pencraft pc-display-flex pc-flexDirection-row pc-alignItems-center pc-justifyContent-flex-start pc-reset ltr-qDBmby"><a href="https://substack.com/@readrichtext" aria-label="View Rich Text's profile" class="pencraft pc-display-contents pc-reset"><div style="--scale:36px;" tabindex="0" class="pencraft pc-display-flex pc-width-36 pc-height-36 pc-justifyContent-center pc-alignItems-center pc-position-relative pc-reset bg-secondary-UUD3_J flex-auto-j3S2WA animate-XFJxE4 outline-detail-vcQLyr pc-borderRadius-full overflow-hidden-WdpwT6 sizing-border-box-DggLA4 pressable-sm-YIJFKJ showFocus-sk_vEm container-TAtrWj interactive-UkK0V6 avatar-u8q6xB last-JfNEJ_"><div style="--scale:36px;" title="Rich Text" class="pencraft pc-display-flex pc-width-36 pc-height-36 pc-justifyContent-center pc-alignItems-center pc-position-relative pc-reset bg-secondary-UUD3_J flex-auto-j3S2WA outline-detail-vcQLyr pc-borderRadius-full overflow-hidden-WdpwT6 sizing-border-box-DggLA4 container-TAtrWj"><picture><source type="image/webp" srcset="https://substackcdn.com/image/fetch/$s_!nVNQ!,w_36,h_36,c_fill,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F8722a66c-f873-4b99-ab10-2486beab6bd0_788x788.png 1x, https://substackcdn.com/image/fetch/$s_!nVNQ!,w_72,h_72,c_fill,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F8722a66c-f873-4b99-ab10-2486beab6bd0_788x788.png 2x, https://substackcdn.com/image/fetch/$s_!nVNQ!,w_108,h_108,c_fill,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F8722a66c-f873-4b99-ab10-2486beab6bd0_788x788.png 3x"/><img src="https://substackcdn.com/image/fetch/$s_!nVNQ!,w_36,h_36,c_fill,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F8722a66c-f873-4b99-ab10-2486beab6bd0_788x788.png" alt="Rich Text's avatar" srcset="https://substackcdn.com/image/fetch/$s_!nVNQ!,w_36,h_36,c_fill,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F8722a66c-f873-4b99-ab10-2486beab6bd0_788x788.png 1x, https://substackcdn.com/image/fetch/$s_!nVNQ!,w_72,h_72,c_fill,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F8722a66c-f873-4b99-ab10-2486beab6bd0_788x788.png 2x, https://substackcdn.com/image/fetch/$s_!nVNQ!,w_108,h_108,c_fill,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F8722a66c-f873-4b99-ab10-2486beab6bd0_788x788.png 3x" width="36" height="36" draggable="false" class="img-OACg1c object-fit-cover-u4ReeV pencraft pc-reset"/></picture></div></div></a></div></div></div><div class="pencraft pc-display-flex pc-flexDirection-column pc-reset"><div class="pencraft pc-reset color-primary-zABazT line-height-20-t4M0El font-meta-MWBumP size-11-NuY2Zx weight-medium-fw81nC transform-uppercase-yKDgcq reset-IxiVJZ meta-EgzBVA"><span style="min-width:0;" data-state="closed"><a href="https://substack.com/@readrichtext" class="pencraft pc-reset decoration-hover-underline-ClDVRM reset-IxiVJZ">Rich Text</a></span></div><div class="pencraft pc-display-flex pc-gap-4 pc-reset"><div class="pencraft pc-reset color-secondary-ls1g8s line-height-20-t4M0El font-meta-MWBumP size-11-NuY2Zx weight-medium-fw81nC transform-uppercase-yKDgcq reset-IxiVJZ meta-EgzBVA"><time datetime="2026-05-13T12:03:50.541Z" title="2026-05-13T12:03:50.541Z">May 13, 2026</time></div></div></div></div></div><div class="pencraft pc-display-flex pc-gap-16 pc-justifyContent-space-between pc-alignItems-center pc-reset flex-grow-rzmknG post-ufi"><div class="pencraft pc-display-flex pc-gap-8 pc-reset"><div class="like-button-container post-ufi-button style-button"><button tabindex="0" type="button" aria-label="Like (1)" aria-pressed="false" class="pencraft pc-reset pencraft post-ufi-button style-button has-label with-border"><svg aria-hidden="true" style="height:20px;width:20px;" width="20" height="20" viewBox="0 0 24 24" fill="#000000" stroke-width="2" stroke="#000" xmlns="http://www.w3.org/2000/svg" class="icon"><g><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-heart"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg></g></svg><div class="label">1</div></button></div><button tabindex="0" type="button" aria-label="View comments (0)" data-href="https://readrichtext.substack.com/p/liberal-bullshittery-an-autopsy-of/comments" class="pencraft pc-reset pencraft post-ufi-button style-button post-ufi-comment-button no-label with-border"><svg aria-hidden="true" style="height:20px;width:20px;" width="20" height="20" viewBox="0 0 24 24" fill="#000000" stroke-width="2" stroke="#000" xmlns="http://www.w3.org/2000/svg" class="icon"><g><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-circle"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg></g></svg></button><button tabindex="0" type="button" id="radix-P0-27" aria-haspopup="menu" aria-expanded="false" data-state="closed" class="pencraft pc-reset pencraft post-ufi-button style-button has-label with-border"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke-width="2" stroke="var(--color-fg-primary)" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" class="icon"><g><path d="M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882"></path></g></svg><div class="label">1</div></button></div><div class="pencraft pc-display-flex pc-gap-8 pc-reset"><button tabindex="0" type="button" class="pencraft pc-reset pencraft post-ufi-button style-button has-label with-border"><div class="label">Share</div></button></div></div></div></div><div class="visibility-check"></div><div><div class="dt-post-body dropCap-hcUVpW"><div class="available-content"><div dir="auto" class="body markup"><div id="youtube2-gqi0-w_Teuo" data-attrs="{&quot;videoId&quot;:&quot;gqi0-w_Teuo&quot;,&quot;startTime&quot;:null,&quot;endTime&quot;:null}" data-component-name="Youtube2ToDOM" class="youtube-wrap"><div class="youtube-inner"><iframe src="https://www.youtube-nocookie.com/embed/gqi0-w_Teuo?rel=0&amp;autoplay=0&amp;showinfo=0&amp;enablejsapi=0" frameborder="0" loading="lazy" gesture="media" allow="autoplay; fullscreen" allowautoplay="true" allowfullscreen="true" width="728" height="409"></iframe></div></div><blockquote><p>“Explain it to me as if I was a 5th grader, how the expenditures per capita have nearly tripled — and what measurable outcomes she could point to.”</p><p>— Councilwoman Ellis, Metro Council Public Health and Safety Committee, May 7, 2026</p></blockquote><div><hr/></div><p>I’d like to tell you about a budget meeting that happened a few days ago — one of over 50 that our Metro Council members must unfortunately suffer through each spring. </p><p><span>All of these departmental budgets have previously been passed through the desk of the Mayor’s Director of Operations and Performance, Kristin Wilson. You may remember her from </span><a href="https://readrichtext.substack.com/p/breaking-the-mayors-official-coordinating">previous reporting</a><span>: she is the mayor’s office official who coordinated Nashville’s $15 million surveillance agreement with the Downtown Partnership, and who, before entering government, </span><a href="https://theintercept.com/2023/06/20/lexisnexis-ice-surveillance-license-plates">helped build the data infrastructure</a><span> that ICE now uses to track immigrants. Put a pin in that name.</span></p><p><span>I want to discuss this particular hearing because it is a case study in what I’ll call — with what sounds like glib derision at first, but I actually mean in a very precise sense — </span><em>liberal bullshittery</em><span>.</span></p><div class="subscription-widget-wrap"><div class="subscription-widget show-subscribe"><div class="preamble"><p>{Rich Text} is a reader-supported publication. To receive new posts and support my work, consider becoming a free or paid subscriber.</p></div><div data-component-name="SubscribeWidget" class="subscribe-widget"><div class="pencraft pc-display-flex pc-justifyContent-center pc-reset"><div class="container-IpPqBD"><form action="/api/v1/free?nojs=true" method="post" novalidate class="form form-M5sC90"><input type="hidden" name="first_url" value/><input type="hidden" name="first_referrer" value/><input type="hidden" name="current_url"/><input type="hidden" name="current_referrer"/><input type="hidden" name="first_session_url" value/><input type="hidden" name="first_session_referrer" value/><input type="hidden" name="referral_code"/><input type="hidden" name="source" value="subscribe-widget-preamble"/><input type="hidden" name="referring_pub_id"/><input type="hidden" name="additional_referring_pub_ids"/><input type="hidden" name="source_post_id" value="197441967"/><div class="sideBySideWrap-vGXrwP"><div class="emailInputWrapper-QlA86j"><div class="pencraft pc-display-flex pc-minWidth-0 pc-position-relative pc-reset flex-auto-j3S2WA"><input name="email" placeholder="Type your email..." type="email" class="pencraft emailInput-OkIMeB input-y4v6N4 inputText-pV_yWb"/></div></div><button tabindex="0" type="submit" disabled class="pencraft pc-reset pencraft rightButton primary subscribe-btn button-VFSdkv buttonBase-GK1x3M"><span class="button-text ">Subscribe</span></button></div><div id="error-container"></div></form></div></div></div></div></div><p>This is a story about homelessness. But it is not only a story about homelessness. It is about how democratic governance gets converted into ungovernable corporate governance under progressive branding — and how that conversion, happening quietly in city budget hearings across the country, is the precondition for the authoritarian capture we are watching unfold at the national level. </p><p>A budget hearing for a two-year-old department in a mid-size Southern city is a strange place to see this clearly. But it is the right place, because this is where it actually happens: not in manifestos or think tanks, but in line items, sole-source contracts, and the systematic removal of every mechanism that would let the public know what is being done in its name.</p><p>Here's the thing: scrutinizing the funding of a homelessness department is not gotcha politics. It is not about scoring points or embarrassing an administration. It is about the fact that unhoused people are, by every empirical measure, the most vulnerable population in our society. They are the most likely to be sexually assaulted, the most likely to be sex trafficked, the most likely to have their very bodies collected, dissected, and sold for profit without their consent or their families' knowledge. </p><p>When we allow the agencies charged with serving this population to operate without clear, rigorous oversight, when we tolerate opaque budgets, unreviewed contracts, and a culture of institutional secrecy around how public dollars are spent, we are not merely risking inefficiency or waste. We are, unequivocally, increasing the amount of violent harm that human beings will suffer. </p><p>The misuse of public funds is never acceptable. The lack of candor about their deployment is never acceptable. But directing that misuse and that secrecy toward the most powerless people in our city, people who cannot lobby, cannot litigate, cannot call a press conference, and whose disappearance from public life is treated not as an emergency but as an aesthetic improvement, is unconscionable. </p><p>Oversight is not an attack. It is the bare minimum of what a democratic society owes to those it has already failed. And to fight that oversight is to take the side of the sex traffickers, illegal corpse resellers, and extortionists who see our unhoused neighbors not as humans but as easy prey.</p><p>But back to “Liberal Bullshittery.”</p><p><span>By </span><em>liberal</em><span>, I mean it in the sense of neoliberalism: a system that views government as a means to open up the marketplace for profit, and that government services exist to the extent they help the wealthy extract value from places of commerce. And by </span><em>bullshit</em><span>, I mean it precisely as the philosopher Harry Frankfurt </span><a href="https://en.wikipedia.org/wiki/On_Bullshit">defined it</a><span>: speech unconcerned with whether it is true or false, only with whether it is persuasive. </span></p><p>The bullshitter is not a liar. The liar knows the truth and says the opposite. The bullshitter is worse: unmoored from the question of truth entirely, speaking fluently about data and best practices, right some of the time, but fundamentally unconcerned with whether what she is describing is actually working — because the system she operates in is not designed to answer that question. It is designed to avoid it.</p><div><hr/></div><p>Here is the state of play: Nashville’s homeless services network has been systematically redesigned by a former data-broker executive who was parachuted into city government, funded by a billionaire’s philanthropy, to apply corporate strategy to a complex human services ecosystem she had no experience in. </p><p>That system now imports consulting models built for downtown business districts, spends public money outside procurement law, and has castrated the one local governing body that could hold it accountable. The people closest to the problem, outreach workers, case managers, the unhoused themselves, are the last to be consulted and the first to be overridden.</p><p>The political economist Elinor Ostrom spent a career proving that this is precisely how you destroy a commons: not through neglect, but through confident outside intervention that dismantles the local institutional knowledge and trust networks communities spent decades building.</p><p>Curtis Yarvin, a Silicon Valley software engineer turned blogger, bankrolled by Peter Thiel, and godfather of the anti-democratic “Dark Enlightenment” movement, has a name for what this looks like when it is done on purpose. </p><p>He calls it neocameralism: the state run as a corporation, the executive as CEO-monarch, democratic oversight dissolved as inefficiency. In his writings, Yarvin sorts humanity into racial categories he calls “elves, hobbits, dwarves, orcs, and zombies.” </p><div class="captioned-image-container"><figure><a target="_blank" href="https://english.elpais.com/usa/2025-08-19/curtis-yarvins-brave-new-world-we-need-a-corporate-dictatorship-to-replace-a-dying-democracy.html" data-component-name="Image2ToDOM" class="image-link image2 is-viewable-img can-restack"><div class="image2-inset"><picture><source type="image/webp" srcset="https://substackcdn.com/image/fetch/$s_!uzZb!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F57aac5cc-54bf-42f7-8b2a-81dbad62fd3a_992x1484.png 424w, https://substackcdn.com/image/fetch/$s_!uzZb!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F57aac5cc-54bf-42f7-8b2a-81dbad62fd3a_992x1484.png 848w, https://substackcdn.com/image/fetch/$s_!uzZb!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F57aac5cc-54bf-42f7-8b2a-81dbad62fd3a_992x1484.png 1272w, https://substackcdn.com/image/fetch/$s_!uzZb!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F57aac5cc-54bf-42f7-8b2a-81dbad62fd3a_992x1484.png 1456w" sizes="100vw"/><img src="https://substackcdn.com/image/fetch/$s_!uzZb!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F57aac5cc-54bf-42f7-8b2a-81dbad62fd3a_992x1484.png" width="992" height="1484" data-attrs="{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/57aac5cc-54bf-42f7-8b2a-81dbad62fd3a_992x1484.png&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:1484,&quot;width&quot;:992,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:1108775,&quot;alt&quot;:null,&quot;title&quot;:null,&quot;type&quot;:&quot;image/png&quot;,&quot;href&quot;:&quot;https://english.elpais.com/usa/2025-08-19/curtis-yarvins-brave-new-world-we-need-a-corporate-dictatorship-to-replace-a-dying-democracy.html&quot;,&quot;belowTheFold&quot;:true,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://readrichtext.substack.com/i/197441967?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F57aac5cc-54bf-42f7-8b2a-81dbad62fd3a_992x1484.png&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}" alt srcset="https://substackcdn.com/image/fetch/$s_!uzZb!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F57aac5cc-54bf-42f7-8b2a-81dbad62fd3a_992x1484.png 424w, https://substackcdn.com/image/fetch/$s_!uzZb!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F57aac5cc-54bf-42f7-8b2a-81dbad62fd3a_992x1484.png 848w, https://substackcdn.com/image/fetch/$s_!uzZb!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F57aac5cc-54bf-42f7-8b2a-81dbad62fd3a_992x1484.png 1272w, https://substackcdn.com/image/fetch/$s_!uzZb!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F57aac5cc-54bf-42f7-8b2a-81dbad62fd3a_992x1484.png 1456w" sizes="100vw" loading="lazy" class="sizing-normal"/></picture><div class="image-link-expand"><div class="pencraft pc-display-flex pc-gap-8 pc-reset"><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container restack-image"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke-width="1.5" stroke="var(--color-fg-primary)" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><g><path d="M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882"></path></g></svg></button><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container view-image"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-maximize2 lucide-maximize-2"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" x2="14" y1="3" y2="10"></line><line x1="3" x2="10" y1="21" y2="14"></line></svg></button></div></div></div></a></figure></div><p>His operational plan, which he calls RAGE (Retire All Government Employees), is widely recognized as the blueprint for Musk’s DOGE. Vice President Vance cited Yarvin by name and said Trump should “fire every single mid-level bureaucrat” and ignore the courts when they push back. Yarvin attended Trump’s inaugural ball. </p><p>But a government cannot just become a corporation over night.</p><p>The people who redesigned Nashville’s homeless services system have almost certainly never read, or likely have even heard of Curtis Yarvin. Yet they are building precisely what he describes, doing it in the name of “innovation” and “efficiency.”</p><p>You will recognize this pattern by the end of this piece. But first, how would we actually end homelessness, if that was a thing we actually wanted to do?</p><div><hr/></div><h3 class="header-anchor-post">It’s not a mystery.<div class="pencraft pc-display-flex pc-alignItems-center pc-position-absolute pc-reset header-anchor-parent"><div class="pencraft pc-display-contents pc-reset pubTheme-yiXxQA"><div id="§its-not-a-mystery" class="pencraft pc-reset header-anchor offset-top"></div><button tabindex="0" type="button" aria-label="Link" data-href="https://readrichtext.substack.com/i/197441967/its-not-a-mystery" class="pencraft pc-reset pencraft iconButton-mq_Et5 iconButtonBase-dJGHgN buttonBase-GK1x3M buttonStyle-r7yGCK size_sm-G3LciD priority_secondary-S63h9o"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></button></div></div></h3><p><a href="https://en.wikipedia.org/wiki/Pathways_to_Housing">Sam Tsemberis proved it in 1992</a><span>: give people permanent housing without preconditions, with support services available but not required, and </span><a href="https://ajph.aphapublications.org/doi/10.2105/AJPH.94.4.651">85–90% stay housed</a><span>. </span><a href="https://housingfirsteurope.eu/country/finland/">Finland proved it nationally</a><span>. The VA proved it with veterans. Will Connelly, who ran both Nashville’s Homelessness Commission and </span><a href="https://www.nashvillepost.com/business/nonprofits/new-leader-of-the-contributor-plans-for-next-era/article_c6c5f054-9085-11ee-9fd8-a70cb52775d3.html">Metro Denver’s Homeless Initiative</a><span>, put the test simply: “A real system is defined by whether those efforts are aligned around a single, measurable goal: helping people exit homelessness quickly and permanently.”</span></p><p>We do not have a system that sets a clear goal like this that honestly appraises it's progress. But even its leaders know what the resource problem really is, if they come up empty handed for any real ideas to solve it.</p><div class="captioned-image-container"><figure><a target="_blank" href="https://www.urban.org/sites/default/files/2023-02/Decommodification%20and%20Its%20Role%20in%20Advancing%20Housing%20Justice.pdf" data-component-name="Image2ToDOM" class="image-link image2 is-viewable-img can-restack"><div class="image2-inset"><picture><source type="image/webp" srcset="https://substackcdn.com/image/fetch/$s_!PAPh!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F66e199b5-9ac7-4a07-a821-ab4edcaf15b5_910x1178.png 424w, https://substackcdn.com/image/fetch/$s_!PAPh!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F66e199b5-9ac7-4a07-a821-ab4edcaf15b5_910x1178.png 848w, https://substackcdn.com/image/fetch/$s_!PAPh!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F66e199b5-9ac7-4a07-a821-ab4edcaf15b5_910x1178.png 1272w, https://substackcdn.com/image/fetch/$s_!PAPh!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F66e199b5-9ac7-4a07-a821-ab4edcaf15b5_910x1178.png 1456w" sizes="100vw"/><img src="https://substackcdn.com/image/fetch/$s_!PAPh!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F66e199b5-9ac7-4a07-a821-ab4edcaf15b5_910x1178.png" width="394" height="510.03516483516484" data-attrs="{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/66e199b5-9ac7-4a07-a821-ab4edcaf15b5_910x1178.png&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:1178,&quot;width&quot;:910,&quot;resizeWidth&quot;:394,&quot;bytes&quot;:1020823,&quot;alt&quot;:null,&quot;title&quot;:null,&quot;type&quot;:&quot;image/png&quot;,&quot;href&quot;:&quot;https://www.urban.org/sites/default/files/2023-02/Decommodification%20and%20Its%20Role%20in%20Advancing%20Housing%20Justice.pdf&quot;,&quot;belowTheFold&quot;:true,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://readrichtext.substack.com/i/197441967?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F66e199b5-9ac7-4a07-a821-ab4edcaf15b5_910x1178.png&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}" alt srcset="https://substackcdn.com/image/fetch/$s_!PAPh!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F66e199b5-9ac7-4a07-a821-ab4edcaf15b5_910x1178.png 424w, https://substackcdn.com/image/fetch/$s_!PAPh!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F66e199b5-9ac7-4a07-a821-ab4edcaf15b5_910x1178.png 848w, https://substackcdn.com/image/fetch/$s_!PAPh!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F66e199b5-9ac7-4a07-a821-ab4edcaf15b5_910x1178.png 1272w, https://substackcdn.com/image/fetch/$s_!PAPh!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F66e199b5-9ac7-4a07-a821-ab4edcaf15b5_910x1178.png 1456w" sizes="100vw" loading="lazy" class="sizing-normal"/></picture><div class="image-link-expand"><div class="pencraft pc-display-flex pc-gap-8 pc-reset"><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container restack-image"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke-width="1.5" stroke="var(--color-fg-primary)" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><g><path d="M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882"></path></g></svg></button><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container view-image"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-maximize2 lucide-maximize-2"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" x2="14" y1="3" y2="10"></line><line x1="3" x2="10" y1="21" y2="14"></line></svg></button></div></div></div></a></figure></div><p>Office of Homeless Services Director April Calvin told the Metro Council committee on Wednesday that “housing is what we need more of.” </p><p>It is not her office’s remit to develop decomodified housing. What is it that they do instead?</p><p>She described her office as “data-driven.” She claims that it is an in-joke in her office that she asks, before making any decision, “Show me the data.” And then she presented a budget that revealed a system designed to avoid being held accountable to any of it.</p><div><hr/></div><h3 class="header-anchor-post">The question that couldn’t be answered simply<div class="pencraft pc-display-flex pc-alignItems-center pc-position-absolute pc-reset header-anchor-parent"><div class="pencraft pc-display-contents pc-reset pubTheme-yiXxQA"><div id="§the-question-that-couldnt-be-answered-simply" class="pencraft pc-reset header-anchor offset-top"></div><button tabindex="0" type="button" aria-label="Link" data-href="https://readrichtext.substack.com/i/197441967/the-question-that-couldnt-be-answered-simply" class="pencraft pc-reset pencraft iconButton-mq_Et5 iconButtonBase-dJGHgN buttonBase-GK1x3M buttonStyle-r7yGCK size_sm-G3LciD priority_secondary-S63h9o"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></button></div></div></h3><p><span>Nashville has spent $50 million in federal ARPA funds on homelessness since October 2022. OHS’s budget has grown to FY27 ask of $10,318,000 from the general budget. The results: housing placements </span><em>are down</em><span> 13% year over year. The </span><a href="https://www.nashville.gov/departments/office-homeless-services/news/2025-point-time-count">2025 PIT count</a><span>, revealed on a single budget slide Wednesday, shows 2,180 people, a 4.1% increase. For every one person Nashville houses, 2.5 enter homelessness.</span></p><div class="captioned-image-container"><figure><a target="_blank" href="https://substackcdn.com/image/fetch/$s_!Quwt!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F676d1b1a-34ed-4675-b769-30b13764e21c_2144x1228.png" data-component-name="Image2ToDOM" class="image-link image2 is-viewable-img can-restack"><div class="image2-inset"><picture><source type="image/webp" srcset="https://substackcdn.com/image/fetch/$s_!Quwt!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F676d1b1a-34ed-4675-b769-30b13764e21c_2144x1228.png 424w, https://substackcdn.com/image/fetch/$s_!Quwt!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F676d1b1a-34ed-4675-b769-30b13764e21c_2144x1228.png 848w, https://substackcdn.com/image/fetch/$s_!Quwt!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F676d1b1a-34ed-4675-b769-30b13764e21c_2144x1228.png 1272w, https://substackcdn.com/image/fetch/$s_!Quwt!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F676d1b1a-34ed-4675-b769-30b13764e21c_2144x1228.png 1456w" sizes="100vw"/><img src="https://substackcdn.com/image/fetch/$s_!Quwt!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F676d1b1a-34ed-4675-b769-30b13764e21c_2144x1228.png" width="1456" height="834" data-attrs="{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/676d1b1a-34ed-4675-b769-30b13764e21c_2144x1228.png&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:834,&quot;width&quot;:1456,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:293544,&quot;alt&quot;:null,&quot;title&quot;:null,&quot;type&quot;:&quot;image/png&quot;,&quot;href&quot;:null,&quot;belowTheFold&quot;:true,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://readrichtext.substack.com/i/197441967?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F676d1b1a-34ed-4675-b769-30b13764e21c_2144x1228.png&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}" alt srcset="https://substackcdn.com/image/fetch/$s_!Quwt!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F676d1b1a-34ed-4675-b769-30b13764e21c_2144x1228.png 424w, https://substackcdn.com/image/fetch/$s_!Quwt!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F676d1b1a-34ed-4675-b769-30b13764e21c_2144x1228.png 848w, https://substackcdn.com/image/fetch/$s_!Quwt!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F676d1b1a-34ed-4675-b769-30b13764e21c_2144x1228.png 1272w, https://substackcdn.com/image/fetch/$s_!Quwt!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F676d1b1a-34ed-4675-b769-30b13764e21c_2144x1228.png 1456w" sizes="100vw" loading="lazy" class="sizing-normal"/></picture><div class="image-link-expand"><div class="pencraft pc-display-flex pc-gap-8 pc-reset"><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container restack-image"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke-width="1.5" stroke="var(--color-fg-primary)" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><g><path d="M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882"></path></g></svg></button><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container view-image"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-maximize2 lucide-maximize-2"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" x2="14" y1="3" y2="10"></line><line x1="3" x2="10" y1="21" y2="14"></line></svg></button></div></div></div></a></figure></div><p>Councilwoman Tasha Ellis asked about the per-capita spending. She wanted something she could explain to constituents, specifically to a group of kids at her bus stop who pay attention to this issue. Calvin’s response was that OHS had shifted from housing “the easy to house” to addressing “chronic-level homelessness,” meaning people with longer histories of living outside, more complex needs, higher costs. When you serve harder cases, she said, “you’re going to have to pay a little bit longer.”</p><p>That makes intuitive sense. Harder cases cost more per person. But Calvin had already explained, earlier in the same hearing, how her budget was organized, and the explanation contradicts the answer she gave Ellis.</p><p><span>Nashville’s homeless services system has two funding tracks. The first is </span><strong>coordinated entry</strong><span>, the federal system that uses a scored vulnerability assessment to prioritize who gets housed. Calvin described it clearly: coordinated entry “is focused on the most vulnerable individuals,” people with co-occurring disorders, long lengths of time outside, the highest needs. This is the chronic population. It already has a pipeline.</span></p><p><span>The second track is what Calvin calls </span><strong>MRRF</strong><span>, Metro Rapid Response Funds. This is new local money, created last budget cycle. Calvin described it as being for people who “may not ever really need to wait for that level of trauma to — so that they can get a higher score to be funded through the coordinated entry process.” In other words: MRRF is explicitly for people who are </span><em>not</em><span> the most vulnerable. It exists because coordinated entry only reaches the hardest cases, and Calvin wanted flexible dollars for everyone else.</span></p><p>So: coordinated entry already serves the chronic, hardest-to-house population. MRRF was designed for people outside that population.</p><p>But when Ellis asked why outcomes are declining despite more spending, Calvin’s answer was that they’re now serving the chronic, hardest-to-house population — and that’s why it costs more.</p><p>Both justifications cannot be true about the same system at the same time. </p><p>If coordinated entry, the system long in place before Calvin joined Metro, already serves the most vulnerable, and MRRF was built for everyone else, then declining outcomes can’t be explained by saying you’re doing harder work — because the harder work was already happening through the other track. </p><p>The question is: what the new money is doing, for whom, and why the numbers are moving in the wrong direction. That question went unanswered.</p><div><hr/></div><h3 class="header-anchor-post">The appearance of circumventing<div class="pencraft pc-display-flex pc-alignItems-center pc-position-absolute pc-reset header-anchor-parent"><div class="pencraft pc-display-contents pc-reset pubTheme-yiXxQA"><div id="§the-appearance-of-circumventing" class="pencraft pc-reset header-anchor offset-top"></div><button tabindex="0" type="button" aria-label="Link" data-href="https://readrichtext.substack.com/i/197441967/the-appearance-of-circumventing" class="pencraft pc-reset pencraft iconButton-mq_Et5 iconButtonBase-dJGHgN buttonBase-GK1x3M buttonStyle-r7yGCK size_sm-G3LciD priority_secondary-S63h9o"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></button></div></div></h3><p>Later in the hearing, Calvin said something that helps explain what MRRF is actually for.</p><p>At 56:34, describing why she wants additional funding beyond coordinated entry, Calvin told the committee:</p><blockquote><p>“Thinking of our coordinated entry process and how some of those individuals have been on the list for a very long time, may not have the high score to be housed by way of the coordinated entry process. We’re looking for additional funds where we would not have to appear to circumvent a system or put someone in front of.”</p></blockquote><p><span>Check the tape on that one. The director is not saying MRRF prevents circumvention of the federal priority system. She is saying she wants money so that when her office houses someone outside the priority list, it doesn’t </span><em>look like</em><span> they’re circumventing it. The concern is not the bypass. It is the appearance.</span></p><p>And appearance is, with all Liberal Bullshittery, all that matters.</p><p>Let's be clear: MRRF has no published scoring criteria. It has no public prioritization list. No external body reviews how the funds are distributed. </p><p>When Councilwoman Evans asked whether MRRF has an end date — “when we use pilot, it implies it’s going to end at some point” — Calvin said “October 2026,” at which point they’d “look at the data, review the data, and then figure out the next steps.” </p><p>A pilot without success criteria and an end date that falls after the budget cycle is not a pilot. It is a permanent discretionary fund used however she, but more to the point, the Mayor’s Office, wants to use it.</p><p>When Calvin first introduced MRRF to the Homelessness Planning Council in November 2025, she described the funds as being “made available to Metro Officials.” Not to case managers. Not to people on the by-name list. To officials. The framing tells you who the intended user is.</p><p>And the name itself is new. “MRRF” did not exist as a program until November 2025. Before that, the same money appeared in the Metro budget as “Non-Traditional Rapid Re-Housing.” </p><p>That term is not a term of art in any federal, state, or evidence-based homeless services model. It returns exactly one search result: a FOX 17 article quoting Calvin. She invented a program name, put it in a budget document, got it funded, renamed it to MRRF after reporting revealed the unauthorized placements and evictions it had already produced, and is now asking for it to be expanded. </p><p>In the FY27 budget modifications the committee reviewed Wednesday, MRRF does not appear as its own line item at all. It has been folded into “Community Case Management Funding,” a $2 million ask whose justification text mentions that it “will compliment last year’s MRRF and PSH funding.” Three names in three budget cycles for the same discretionary money with no published criteria. Each rename makes it harder to track.</p><p><span>Renaming something euphemistically, or renaming it out of view entirely: there perhaps is no better manifestation of </span><em>liberal bullshittery.</em></p><div class="captioned-image-container"><figure><a target="_blank" href="https://eclass.aueb.gr/modules/document/file.php/OIK260/Murray%20Edelman%20(Auth.)-Political%20Language.%20Words%20That%20Succeed%20and%20Policies%20That%20Fail-Academic%20Press%20(1977).pdf" data-component-name="Image2ToDOM" class="image-link image2 is-viewable-img can-restack"><div class="image2-inset"><picture><source type="image/webp" srcset="https://substackcdn.com/image/fetch/$s_!pLA-!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fb7baf2b7-fdf3-49f6-84e0-11b587ed323f_1014x1528.png 424w, https://substackcdn.com/image/fetch/$s_!pLA-!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fb7baf2b7-fdf3-49f6-84e0-11b587ed323f_1014x1528.png 848w, https://substackcdn.com/image/fetch/$s_!pLA-!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fb7baf2b7-fdf3-49f6-84e0-11b587ed323f_1014x1528.png 1272w, https://substackcdn.com/image/fetch/$s_!pLA-!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fb7baf2b7-fdf3-49f6-84e0-11b587ed323f_1014x1528.png 1456w" sizes="100vw"/><img src="https://substackcdn.com/image/fetch/$s_!pLA-!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fb7baf2b7-fdf3-49f6-84e0-11b587ed323f_1014x1528.png" width="450" height="678.1065088757397" data-attrs="{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/b7baf2b7-fdf3-49f6-84e0-11b587ed323f_1014x1528.png&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:1528,&quot;width&quot;:1014,&quot;resizeWidth&quot;:450,&quot;bytes&quot;:147695,&quot;alt&quot;:null,&quot;title&quot;:null,&quot;type&quot;:&quot;image/png&quot;,&quot;href&quot;:&quot;https://eclass.aueb.gr/modules/document/file.php/OIK260/Murray%20Edelman%20(Auth.)-Political%20Language.%20Words%20That%20Succeed%20and%20Policies%20That%20Fail-Academic%20Press%20(1977).pdf&quot;,&quot;belowTheFold&quot;:true,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://readrichtext.substack.com/i/197441967?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fb7baf2b7-fdf3-49f6-84e0-11b587ed323f_1014x1528.png&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}" alt srcset="https://substackcdn.com/image/fetch/$s_!pLA-!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fb7baf2b7-fdf3-49f6-84e0-11b587ed323f_1014x1528.png 424w, https://substackcdn.com/image/fetch/$s_!pLA-!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fb7baf2b7-fdf3-49f6-84e0-11b587ed323f_1014x1528.png 848w, https://substackcdn.com/image/fetch/$s_!pLA-!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fb7baf2b7-fdf3-49f6-84e0-11b587ed323f_1014x1528.png 1272w, https://substackcdn.com/image/fetch/$s_!pLA-!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fb7baf2b7-fdf3-49f6-84e0-11b587ed323f_1014x1528.png 1456w" sizes="100vw" loading="lazy" class="sizing-normal"/></picture><div class="image-link-expand"><div class="pencraft pc-display-flex pc-gap-8 pc-reset"><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container restack-image"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke-width="1.5" stroke="var(--color-fg-primary)" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><g><path d="M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882"></path></g></svg></button><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container view-image"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-maximize2 lucide-maximize-2"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" x2="14" y1="3" y2="10"></line><line x1="3" x2="10" y1="21" y2="14"></line></svg></button></div></div></div></a><figcaption class="image-caption">I haven’t read this yet. Seems like a good time.</figcaption></figure></div><div><hr/></div><h3 class="header-anchor-post">The number that sounds too good<div class="pencraft pc-display-flex pc-alignItems-center pc-position-absolute pc-reset header-anchor-parent"><div class="pencraft pc-display-contents pc-reset pubTheme-yiXxQA"><div id="§the-number-that-sounds-too-good" class="pencraft pc-reset header-anchor offset-top"></div><button tabindex="0" type="button" aria-label="Link" data-href="https://readrichtext.substack.com/i/197441967/the-number-that-sounds-too-good" class="pencraft pc-reset pencraft iconButton-mq_Et5 iconButtonBase-dJGHgN buttonBase-GK1x3M buttonStyle-r7yGCK size_sm-G3LciD priority_secondary-S63h9o"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></button></div></div></h3><p>OHS has cited an 85% retention rate for people it places in housing, meaning only 15% return to homelessness. If true, this would be an extraordinary outcome — matching the results Tsemberis achieved with Pathways Housing First under controlled conditions with permanent supportive housing and voluntary wraparound services.</p><p>I am calling bullshit on this number.</p><p>An 85% retention rate would require actively verifying that the people placed in housing are still there. After talking to former OHS employees, to case managers in the field, and to people who were placed by OHS and subsequently evicted or otherwise lost their housing, I have found no evidence that OHS is conducting any such verification. Literally, it seems that no one proactively checks to see if people are still housed.</p><p>From what I can determine, the 15% displacement rate represents only those individuals who re-entered the homeless services system and were successfully re-identified in HMIS — not duplicated as a new record, but matched to their existing case. A former staffer on the landlord engagement team confirmed that duplicate records are common and that no, they do not actively check to ensure people have not been displaced.</p><p><span>This means the 85% figure does not measure how many people are still housed. It measures how many people who lost their housing managed to find their way back into the system and were correctly re-entered. This is </span><a href="https://en.wikipedia.org/wiki/Survivorship_bias">survivorship bias</a><span>: counting only the cases that remain visible to the system and treating everyone who disappears as a success.</span></p><div><hr/></div><h3 class="header-anchor-post">The audit no one mentioned<div class="pencraft pc-display-flex pc-alignItems-center pc-position-absolute pc-reset header-anchor-parent"><div class="pencraft pc-display-contents pc-reset pubTheme-yiXxQA"><div id="§the-audit-no-one-mentioned" class="pencraft pc-reset header-anchor offset-top"></div><button tabindex="0" type="button" aria-label="Link" data-href="https://readrichtext.substack.com/i/197441967/the-audit-no-one-mentioned" class="pencraft pc-reset pencraft iconButton-mq_Et5 iconButtonBase-dJGHgN buttonBase-GK1x3M buttonStyle-r7yGCK size_sm-G3LciD priority_secondary-S63h9o"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></button></div></div></h3><p>Councilwoman Zulfat Suara went directly at the landlord program: “I’ve had complaints about slum landlords and people being evicted and a revolving door for people that we’re putting in homes.” </p><p>Calvin deflected, suggesting the revolving door might be a service provider’s problem, then described plans to fix it — all things that should already exist in a program that has spent over $350,000 in rent payments outside any procurement contract. </p><p>Councilwoman Evans followed up with a case from her own district: “a landlord ended up evicting somebody, potentially more than one person, just because they had the right to do it.” OHS didn’t have the capacity to intervene.</p><p>What Suara and Evans were describing, from opposite ends of the same problem, are the programs currently under investigation.</p><p><span>Calvin did talk about the importance of oversight in the meeting, but not of her department, but </span><em>by her department </em><span>over others. She told the committee she wanted “accountability, transparency, and performance-based” practices over the community organizations they provide money to. OHS is not well positioned to be overseeing financial practices of anyone.</span></p><p>What she did not mention, and no committee member raised, is that OHS is currently under a formal Metro audit requested by Councilmember Ginny Welsch and approved by the Audit Committee in September 2025. </p><p>The audit request cites $3.2 million in potential financial irregularities. The Office of Internal Audit was already separately investigating $500,000 in “landlord engagement” spending. The programs Calvin was citing as successes are the programs under investigation.</p><p><a href="https://www.nashvillescene.com/news/citylimits/office-of-homeless-services-2025/article_053499a2-9ac8-4664-9710-a759932e62cf.html">Nashville Scene reporting</a><span> found that Calvin hand-picked families from the Nashville Rescue Mission and moved them to private landlords on verbal rent guarantees, no contract, no competitive bidding, no documented obligations to the tenants. Rent payments came late or not at all. In at least two cases, landlords initiated eviction proceedings against the people OHS was supposed to be housing. OHS has made over $350,000 in direct rent payments to landlords outside any procurement process.</span></p><p>I have been provided multiple email chains showing people placed in housing through MRRF or similar areangements facing eviction while OHS was non-responsive, and at least one case where OHS attempted to shift responsibility to a third-party case manager who believed she was being set up to take the fall for a displacement that OHS’s own off-contract placement process created.</p><p>DePaul USA, the operator of Strobel House (which Calvin described to the committee as under OHS “oversight”), billed over $1 million against a $500,000 contract, submitting retroactive invoices for a service period the contract had already covered. Calvin acknowledged the overrun in a July 2024 email to councilmembers. </p><p>Four incidents at Strobel (two fires, a stabbing, and an employee injury) reportedly occurred during a period when Metro did not have an active contract with DePaul. The only apparent accountability to date: DePaul’s CEO, after 15 years in the position, departed after these revelations surfaced. Mayor O’Connell’s office has taken no public acts of oversight since the audit was approved in September.</p><p><span>In December, Metro Council unanimously passed </span><a href="https://nashville.legistar.com/LegislationDetail.aspx?ID=7778274&amp;GUID=3F3BCDD9-3D97-4817-BB93-11D613D6EBA9">RS2025-1711</a><span>, asking OHS to present a plan for how it would use its $4.4 million budget increase. OHS and the mayor’s office opposed the resolution. It passed anyway. OHS eventually did deliver a response, but it did not resemble what was requested: no methodology for who would receive funds, no prioritization criteria, no framework that would distinguish MRRF from a slush fund used to move unhoused people at the direction of council members and department heads.</span></p><p>Calvin opened the hearing on Wednesday by describing OHS as “a 2-year-old department” eager to share “the great strides that we’ve made with, and some of the challenges that we had along the way.” Payments outside contracts, invoices exceeding authorizations, families moved on verbal guarantees and then evicted, a CEO resignation, and a Council-mandated spending plan answered with a non-answer: these are not challenges along the way. They are a pattern.</p><p>And Calvin did not design it. Remember that pin?</p><div><hr/></div><h3 class="header-anchor-post">The Designer of Operations<div class="pencraft pc-display-flex pc-alignItems-center pc-position-absolute pc-reset header-anchor-parent"><div class="pencraft pc-display-contents pc-reset pubTheme-yiXxQA"><div id="§the-designer-of-operations" class="pencraft pc-reset header-anchor offset-top"></div><button tabindex="0" type="button" aria-label="Link" data-href="https://readrichtext.substack.com/i/197441967/the-designer-of-operations" class="pencraft pc-reset pencraft iconButton-mq_Et5 iconButtonBase-dJGHgN buttonBase-GK1x3M buttonStyle-r7yGCK size_sm-G3LciD priority_secondary-S63h9o"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></button></div></div></h3><p>Kristin Wilson, the Mayor’s Director of Operations and Performance, meets with every department to help shape the budget the mayor requests from Council. She is also the person who built Nashville’s homeless services system. </p><p><span>Before Nashville, Wilson was </span><a href="https://www.atlantaga.gov/Home/Components/News/News/618/672?arch=1&amp;npage=83">placed in Atlanta city government by Bloomberg Philanthropies</a><span>, which invested $3.3 million to create an Innovation Delivery Team under Mayor Kasim Reed. Her mandate: improve relationships with the business community and and reduce street homelessness. In that order. </span></p><p>Before Atlanta, Wilson was Vice President of Market Planning at LexisNexis Risk Solutions, where she managed $50 million in revenue. A data-broker executive, funded by a billionaire’s philanthropy, installed in city government to apply corporate strategy to the management of homeless bodies in commercial corridors.</p><p><span>Wilson came to Nashville on </span><a href="https://www.nashvillepost.com/day-one-cooper-makes-appointments-holds-first-meetings/article_8470e754-8965-5368-b249-b9867c9bd794.html">Cooper’s first day in office</a><span> as his Chief of Operations and Performance. </span><a href="https://www.nashvillescene.com/news/pithinthewind/cooper-pushes-for-higher-cash-reserves/article_cac76024-7bf6-11ed-af58-e7b4afe6270e.html">Nashville Scene reported</a><span> that she was hired in the context of pressure from the state comptroller’s office on the city’s finances; her </span><a href="https://www.thevoicenashville.com/featured/in-or-out-cooper-administration-edition/">father-in-law was Justin Wilson</a><span>, Tennessee’s </span><a href="https://comptroller.tn.gov/about-us/meet-the-comptroller-of-the-treasury.html">long-time state comptroller</a><span>, now comptroller emeritus. </span></p><p><span>Two years later, the Cooper administration commissioned Stacy Horn Koch — who had worked alongside Wilson in Atlanta — to conduct a $500,000 study of Nashville’s homeless services. Then-Councilmember Freddie O’Connell sponsored the legislation. The study’s entity was Housing NOLA, a Louisiana nonprofit. Open Table Nashville’s executive director </span><a href="https://www.wkrn.com/news/local-news/nashville/nashville-breaks-ground-on-housing-support-center-for-homeless/">called it</a><span> “a colossal waste of $500,000, to tell us exactly what we already knew.” A </span><a href="https://www.nashville.gov/sites/default/files/2021-03/Focus-Strategies-Nashville-Systems-Performance-Report.pdf">comparable assessment by Focus Strategies in 2015</a><span> reached substantially similar conclusions for $25,000.</span></p><div class="captioned-image-container"><figure><a target="_blank" href="https://substackcdn.com/image/fetch/$s_!55eQ!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7ef10e7c-6969-404e-bce6-84398035e9f2_1210x1570.png" data-component-name="Image2ToDOM" class="image-link image2 is-viewable-img can-restack"><div class="image2-inset"><picture><source type="image/webp" srcset="https://substackcdn.com/image/fetch/$s_!55eQ!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7ef10e7c-6969-404e-bce6-84398035e9f2_1210x1570.png 424w, https://substackcdn.com/image/fetch/$s_!55eQ!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7ef10e7c-6969-404e-bce6-84398035e9f2_1210x1570.png 848w, https://substackcdn.com/image/fetch/$s_!55eQ!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7ef10e7c-6969-404e-bce6-84398035e9f2_1210x1570.png 1272w, https://substackcdn.com/image/fetch/$s_!55eQ!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7ef10e7c-6969-404e-bce6-84398035e9f2_1210x1570.png 1456w" sizes="100vw"/><img src="https://substackcdn.com/image/fetch/$s_!55eQ!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7ef10e7c-6969-404e-bce6-84398035e9f2_1210x1570.png" width="1210" height="1570" data-attrs="{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/7ef10e7c-6969-404e-bce6-84398035e9f2_1210x1570.png&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:1570,&quot;width&quot;:1210,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:349332,&quot;alt&quot;:null,&quot;title&quot;:null,&quot;type&quot;:&quot;image/png&quot;,&quot;href&quot;:null,&quot;belowTheFold&quot;:true,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://readrichtext.substack.com/i/197441967?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7ef10e7c-6969-404e-bce6-84398035e9f2_1210x1570.png&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}" alt srcset="https://substackcdn.com/image/fetch/$s_!55eQ!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7ef10e7c-6969-404e-bce6-84398035e9f2_1210x1570.png 424w, https://substackcdn.com/image/fetch/$s_!55eQ!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7ef10e7c-6969-404e-bce6-84398035e9f2_1210x1570.png 848w, https://substackcdn.com/image/fetch/$s_!55eQ!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7ef10e7c-6969-404e-bce6-84398035e9f2_1210x1570.png 1272w, https://substackcdn.com/image/fetch/$s_!55eQ!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F7ef10e7c-6969-404e-bce6-84398035e9f2_1210x1570.png 1456w" sizes="100vw" loading="lazy" class="sizing-normal"/></picture><div class="image-link-expand"><div class="pencraft pc-display-flex pc-gap-8 pc-reset"><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container restack-image"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke-width="1.5" stroke="var(--color-fg-primary)" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><g><path d="M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882"></path></g></svg></button><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container view-image"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-maximize2 lucide-maximize-2"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" x2="14" y1="3" y2="10"></line><line x1="3" x2="10" y1="21" y2="14"></line></svg></button></div></div></div></a></figure></div><p>Koch’s study produced the framework for the current system. Then Koch received a second contract through Housing NOLA to implement her own recommendations — a well-documented ethical problem in which the person diagnosing the problem is also the one paid to fix it. </p><p>That second contract: “assistance with homeless encampment closures,” was initially set at $237,100, exactly $12,900 under the $250,000 threshold requiring Metro Council approval. It was then amended to $250,000, designated IDIQ (Indefinite Delivery/Indefinite Quantity), sole source, and flagged “High Risk” by the Finance Department. Housing NOLA was listed as “Uncertified/Unapproved.” Marked “Requires Council Legislation: No.” </p><p>Total Koch compensation: $750,000 from an out-of-state vendor, sole-sourced, flagged high risk, none through competitive procurement.</p><p>The pattern of spending public homelessness money in ways that bypass normal oversight did not begin with MRRF. It began at the system’s redesign, with the same person who today helps set every budget line every department leader presents to Council.</p><p>And all on a contact that had a single Council sponsor. Then District 19 Council Member Freddie O’Connell. </p><div><hr/></div><h3 class="header-anchor-post">$2.7 million for the consulting model that explains all of this<div class="pencraft pc-display-flex pc-alignItems-center pc-position-absolute pc-reset header-anchor-parent"><div class="pencraft pc-display-contents pc-reset pubTheme-yiXxQA"><div id="§27-million-for-the-consulting-model-that-explains-all-of-this" class="pencraft pc-reset header-anchor offset-top"></div><button tabindex="0" type="button" aria-label="Link" data-href="https://readrichtext.substack.com/i/197441967/27-million-for-the-consulting-model-that-explains-all-of-this" class="pencraft pc-reset pencraft iconButton-mq_Et5 iconButtonBase-dJGHgN buttonBase-GK1x3M buttonStyle-r7yGCK size_sm-G3LciD priority_secondary-S63h9o"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></button></div></div></h3><p>The budget request that drew some of the least scrutiny on Wednesday deserves the most, because it reveals where Nashville’s homeless services system is heading, and whose playbook it is following.</p><p>Calvin requested $2.7 million for what she described as connecting “with downtown initiatives, MNPD, or even the nightlife outreach efforts.” Three different things introduced as a single ask. </p><p>The line item description in the budget document tells you what this money is for, in the department’s own words: “This downtown initiative will help to increase tourism, increase city revenue, and secure safe housing options for our most chronically homeless individuals.” Tourism first. Revenue second. Housing third.</p><p>When a committee member asked about it, Calvin’s answer touched every keyword without landing on a single deliverable. She described how MNPD officers currently call OHS when they encounter someone experiencing homelessness, a phone referral that doesn’t cost $2.7 million. She name-dropped Community Solutions, a New York-based organization that runs the Built for Zero initiative, and Clutch Consulting.</p><p>Calvin name-dropping both organizations in the same breath is not casual. It is a signal about what the $2.7 million is for.</p><p><span>Clutch Consulting Group was founded by Houston’s former Special Assistant to the Mayor for Homeless Initiatives. Their website describes a product called </span><a href="https://www.clutchconsultinggroup.com/work/transforming-unsheltered-response/">“Transforming Unsheltered Response”</a><span> with four strategies, the third of which is titled, verbatim: “Close Downtowns to Street Sleeping.” </span></p><p><span>Their service offering includes helping communities </span><a href="https://www.clutchconsultinggroup.com/work/transforming-unsheltered-response/">“leverage new partners including downtowns and law enforcement to close areas to outdoor sleeping.”</a><span> The $2.7 million budget line Calvin submitted — connecting downtown initiatives, MNPD, and nightlife outreach — is the Clutch pitch deck with Nashville proper nouns swapped in.</span></p><p>Nashville is not listed among Clutch’s public clients, which include Dallas, Oklahoma City, New Orleans, Atlanta, Denver, Cleveland, Hartford, and Sacramento. Either Nashville is a prospective client, or OHS is adopting the model informally, or the relationship has not been publicly disclosed. In any case, the model is present in the budget.</p><p>Here is the thing about the Clutch model: in cities where it has been fully resourced, it appears to produce results. Dallas reports a 19% overall reduction in homelessness and over 10,000 people rehoused. Oklahoma City housed 126 people in its first months. Atlanta’s Downtown Rising initiative has housed over 450 people ahead of the 2026 World Cup.</p><p>But in every one of those cities, the model was funded with significant private philanthropy alongside public dollars — Dallas had $10 million from foundations, Oklahoma City at least $5 million, Atlanta raised $156.9 million of a $235 million goal with corporate backers including Coca-Cola and Southern Company. The model also requires dedicated landlord liaison teams, case management infrastructure, rapid onsite document processing, and published criteria for who gets housed. </p><p><span>In cities that adopted the model without this infrastructure, the results were different: in New Orleans, when the Tchoupitoulas encampment was closed, some residents had nowhere to go; the executive director of UNITY of Greater New Orleans </span><a href="https://veritenews.org/2023/11/17/city-encampment-closure-residents/">called it</a><span> “a primary weakness in the process.” A man in a wheelchair with a shattered hip was told to move or face trespassing fines.</span></p><p>“It’s an eyesore, I don’t blame them,” he told reporters. “But goddamn, some of us don’t have the choice of where to live.”</p><div class="captioned-image-container"><figure><a target="_blank" href="https://substackcdn.com/image/fetch/$s_!ZBUF!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F083f9401-4a47-4294-9a2e-17ddd6433f1b_2048x1536.jpeg" data-component-name="Image2ToDOM" class="image-link image2 is-viewable-img can-restack"><div class="image2-inset"><picture><source type="image/webp" srcset="https://substackcdn.com/image/fetch/$s_!ZBUF!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F083f9401-4a47-4294-9a2e-17ddd6433f1b_2048x1536.jpeg 424w, https://substackcdn.com/image/fetch/$s_!ZBUF!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F083f9401-4a47-4294-9a2e-17ddd6433f1b_2048x1536.jpeg 848w, https://substackcdn.com/image/fetch/$s_!ZBUF!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F083f9401-4a47-4294-9a2e-17ddd6433f1b_2048x1536.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!ZBUF!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F083f9401-4a47-4294-9a2e-17ddd6433f1b_2048x1536.jpeg 1456w" sizes="100vw"/><img src="https://substackcdn.com/image/fetch/$s_!ZBUF!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F083f9401-4a47-4294-9a2e-17ddd6433f1b_2048x1536.jpeg" width="1456" height="1092" data-attrs="{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/083f9401-4a47-4294-9a2e-17ddd6433f1b_2048x1536.jpeg&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:1092,&quot;width&quot;:1456,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:686982,&quot;alt&quot;:null,&quot;title&quot;:null,&quot;type&quot;:&quot;image/jpeg&quot;,&quot;href&quot;:null,&quot;belowTheFold&quot;:true,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://readrichtext.substack.com/i/197441967?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F083f9401-4a47-4294-9a2e-17ddd6433f1b_2048x1536.jpeg&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}" alt srcset="https://substackcdn.com/image/fetch/$s_!ZBUF!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F083f9401-4a47-4294-9a2e-17ddd6433f1b_2048x1536.jpeg 424w, https://substackcdn.com/image/fetch/$s_!ZBUF!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F083f9401-4a47-4294-9a2e-17ddd6433f1b_2048x1536.jpeg 848w, https://substackcdn.com/image/fetch/$s_!ZBUF!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F083f9401-4a47-4294-9a2e-17ddd6433f1b_2048x1536.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!ZBUF!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F083f9401-4a47-4294-9a2e-17ddd6433f1b_2048x1536.jpeg 1456w" sizes="100vw" loading="lazy" class="sizing-normal"/></picture><div class="image-link-expand"><div class="pencraft pc-display-flex pc-gap-8 pc-reset"><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container restack-image"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke-width="1.5" stroke="var(--color-fg-primary)" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><g><path d="M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882"></path></g></svg></button><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container view-image"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-maximize2 lucide-maximize-2"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" x2="14" y1="3" y2="10"></line><line x1="3" x2="10" y1="21" y2="14"></line></svg></button></div></div></div></a><figcaption class="image-caption">An encampment closed in New Orleans under the oversight of Clutch Consulting Credit: Bobbi-Jeanne Misick / Verite News</figcaption></figure></div><p>Nashville is not adopting the housing half of this model. It is adopting the displacement half — the downtown targeting, the police coordination, the encampment closures, the coordinated entry bypass — without the private funding match, the functional landlord support systems, the governance, or the accountability that make the housing half work.</p><p>And it is doing so through a system that has already demonstrated it cannot follow the procurement rules that currently exist. </p><p>It doesn’t matter whether Clutch’s model works in Dallas or Housing First works in Finland if Nashville cannot execute a contract, verify a retention number, or produce meeting minutes. </p><p>The question is not whether these programs are effective in theory. The question is whether giving $2.7 million to a system that made $350,000 in off-contract rent payments, that held encampment prioritization meetings in secret, that told a journalist its spending “should not be posted publicly,” will produce anything other than more of what it has already produced.</p><p>The committee member who heard all of this immediately read the subtext: “I know that they’re using private police that a lot of people are not happy with.” Calvin did not respond to the private police reference.</p><div><hr/></div><h3 class="header-anchor-post">The encampment decisions are being made in secret<div class="pencraft pc-display-flex pc-alignItems-center pc-position-absolute pc-reset header-anchor-parent"><div class="pencraft pc-display-contents pc-reset pubTheme-yiXxQA"><div id="§the-encampment-decisions-are-being-made-in-secret" class="pencraft pc-reset header-anchor offset-top"></div><button tabindex="0" type="button" aria-label="Link" data-href="https://readrichtext.substack.com/i/197441967/the-encampment-decisions-are-being-made-in-secret" class="pencraft pc-reset pencraft iconButton-mq_Et5 iconButtonBase-dJGHgN buttonBase-GK1x3M buttonStyle-r7yGCK size_sm-G3LciD priority_secondary-S63h9o"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></button></div></div></h3><p>On April 3, 2026, OHS convened the encampment prioritization team, known as PEAT, to choose which encampment to close. I filed a public records request the same day for meeting minutes, attendee names and organizations, correspondence, and any public notice as required by the Tennessee Open Meetings Act.</p><p>TOMA requires that decisions about where government enforcement resources go constitute public meetings.</p><p>The legally mandated response deadline was April 21. It is now May 12. OHS has produced nothing. If no minutes were kept and no public notice was provided, that itself may constitute a violation of state law. </p><div class="captioned-image-container"><figure><a target="_blank" href="https://substackcdn.com/image/fetch/$s_!MWzu!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F08c4ae54-259f-497e-9360-0133df82406f_1412x1850.png" data-component-name="Image2ToDOM" class="image-link image2 is-viewable-img can-restack"><div class="image2-inset"><picture><source type="image/webp" srcset="https://substackcdn.com/image/fetch/$s_!MWzu!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F08c4ae54-259f-497e-9360-0133df82406f_1412x1850.png 424w, https://substackcdn.com/image/fetch/$s_!MWzu!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F08c4ae54-259f-497e-9360-0133df82406f_1412x1850.png 848w, https://substackcdn.com/image/fetch/$s_!MWzu!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F08c4ae54-259f-497e-9360-0133df82406f_1412x1850.png 1272w, https://substackcdn.com/image/fetch/$s_!MWzu!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F08c4ae54-259f-497e-9360-0133df82406f_1412x1850.png 1456w" sizes="100vw"/><img src="https://substackcdn.com/image/fetch/$s_!MWzu!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F08c4ae54-259f-497e-9360-0133df82406f_1412x1850.png" width="1412" height="1850" data-attrs="{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/08c4ae54-259f-497e-9360-0133df82406f_1412x1850.png&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:1850,&quot;width&quot;:1412,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:472360,&quot;alt&quot;:null,&quot;title&quot;:null,&quot;type&quot;:&quot;image/png&quot;,&quot;href&quot;:null,&quot;belowTheFold&quot;:true,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://readrichtext.substack.com/i/197441967?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F08c4ae54-259f-497e-9360-0133df82406f_1412x1850.png&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}" alt srcset="https://substackcdn.com/image/fetch/$s_!MWzu!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F08c4ae54-259f-497e-9360-0133df82406f_1412x1850.png 424w, https://substackcdn.com/image/fetch/$s_!MWzu!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F08c4ae54-259f-497e-9360-0133df82406f_1412x1850.png 848w, https://substackcdn.com/image/fetch/$s_!MWzu!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F08c4ae54-259f-497e-9360-0133df82406f_1412x1850.png 1272w, https://substackcdn.com/image/fetch/$s_!MWzu!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F08c4ae54-259f-497e-9360-0133df82406f_1412x1850.png 1456w" sizes="100vw" loading="lazy" class="sizing-normal"/></picture><div class="image-link-expand"><div class="pencraft pc-display-flex pc-gap-8 pc-reset"><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container restack-image"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke-width="1.5" stroke="var(--color-fg-primary)" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><g><path d="M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882"></path></g></svg></button><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container view-image"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-maximize2 lucide-maximize-2"><polyline points="15 3 21 3 21 9"></polyline><polyline points="9 21 3 21 3 15"></polyline><line x1="21" x2="14" y1="3" y2="10"></line><line x1="3" x2="10" y1="21" y2="14"></line></svg></button></div></div></div></a></figure></div><p>I didn't file the PRR just to be an asshole.</p><p><span>The </span><a href="https://www.usich.gov/guidance-reports-data/federal-guidance-resources/19-strategies-communities-address-encampments">federal best practice</a><span>, published by the U.S. Interagency Council on Homelessness (</span><a href="https://www.whitehouse.gov/presidential-actions/2025/03/continuing-the-reduction-of-the-federal-bureaucracy/">gutted by executive order</a><span> in March 2025), is unambiguous: encampment residents are supposed to be included in discussions and decisions about their encampment, transparently and meaningfully, with a resident-selected spokesperson. Nashville’s PEAT process is the opposite. The meeting happens in secret. The criteria are unpublished. The people in the encampment are the last to know.</span></p><p>And it's also, as I've discussed with OHS’s Legal liaison, illegal. Metro ethics complaints will likely be forthcoming for all those who partook in the meeting.</p><p>But secrecy is how OHS likes to do things.</p><div><hr/></div><h3 class="header-anchor-post">“Should not be posted publicly”<div class="pencraft pc-display-flex pc-alignItems-center pc-position-absolute pc-reset header-anchor-parent"><div class="pencraft pc-display-contents pc-reset pubTheme-yiXxQA"><div id="§should-not-be-posted-publicly" class="pencraft pc-reset header-anchor offset-top"></div><button tabindex="0" type="button" aria-label="Link" data-href="https://readrichtext.substack.com/i/197441967/should-not-be-posted-publicly" class="pencraft pc-reset pencraft iconButton-mq_Et5 iconButtonBase-dJGHgN buttonBase-GK1x3M buttonStyle-r7yGCK size_sm-G3LciD priority_secondary-S63h9o"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></button></div></div></h3><p>When I asked Director Calvin via email to explain unauthorized rent payments I found documentation of, with the mayor and Council leadership copied, she responded: “Utilizing a dynamic process to offer urgent relief through rental assistance (bridge funding or local rapid response) from local government should not be posted publicly.”</p><p>None of those terms are terms of art. This is big bowl of Liberal Bullshittery word salad. They are words arranged to sound like policy while describing nothing auditable.</p><p>But the second part is plain: the director of a public office told a journalist that how public money was spent should not be posted publicly. The mayor and Council leadership were copied. No one objected. </p><p>Here are the facts: Every dollar in the Metro budget is subject to public records request under Tennessee law. If a system cannot survive being described in public, the system is the problem. The government is not, until Curtis Yarvin has his way, a corporation. There are laws, and they say that public expenditures are subject to public oversight.</p><p>I am publishing here for the first time the actual MRRF expenditure records: the spending Calvin said “should not be posted publicly.” These are the disbursements made under the program originally budgeted as “Non-Traditional Rapid Re-Housing,” renamed to MRRF after reporting exposed the unauthorized placements and evictions it produced.</p><p>The names of the people being served were, properly and ethically, redacted by Metro. But the vendor names are visible for review.</p><div data-component-name="FileToDOM" class="file-embed-wrapper"><div class="file-embed-container-reader"><div class="file-embed-container-top"><img src="https://substackcdn.com/image/fetch/$s_!0Cy0!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack.com%2Fimg%2Fattachment_icon.svg" class="file-embed-thumbnail-default"/><div class="file-embed-details"><div class="file-embed-details-h1">Mrrf Invoices Before Oracle Cloud</div><div class="file-embed-details-h2">591KB ∙ PDF file</div></div><a href="https://readrichtext.substack.com/api/v1/file/9953116c-edd4-44d3-a327-20be9fe2047b.pdf" class="file-embed-button wide"><span class="file-embed-button-text">Download</span></a></div><a href="https://readrichtext.substack.com/api/v1/file/9953116c-edd4-44d3-a327-20be9fe2047b.pdf" class="file-embed-button narrow"><span class="file-embed-button-text">Download</span></a></div></div><div data-component-name="FileToDOM" class="file-embed-wrapper"><div class="file-embed-container-reader"><div class="file-embed-container-top"><img src="https://substackcdn.com/image/fetch/$s_!0Cy0!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack.com%2Fimg%2Fattachment_icon.svg" class="file-embed-thumbnail-default"/><div class="file-embed-details"><div class="file-embed-details-h1">Mrrf Invoices After Orcale Cloud</div><div class="file-embed-details-h2">1.73MB ∙ PDF file</div></div><a href="https://readrichtext.substack.com/api/v1/file/af7d72a4-a63e-4066-8406-c515337cf5a3.pdf" class="file-embed-button wide"><span class="file-embed-button-text">Download</span></a></div><a href="https://readrichtext.substack.com/api/v1/file/af7d72a4-a63e-4066-8406-c515337cf5a3.pdf" class="file-embed-button narrow"><span class="file-embed-button-text">Download</span></a></div></div><div data-component-name="FileToDOM" class="file-embed-wrapper"><div class="file-embed-container-reader"><div class="file-embed-container-top"><img src="https://substackcdn.com/image/fetch/$s_!0Cy0!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack.com%2Fimg%2Fattachment_icon.svg" class="file-embed-thumbnail-default"/><div class="file-embed-details"><div class="file-embed-details-h1">Account Ledger Mrrf Before Cloud</div><div class="file-embed-details-h2">14.5KB ∙ XLSX file</div></div><a href="https://readrichtext.substack.com/api/v1/file/da7f3f05-1aba-4178-ba04-dd4d8ce19d6d.xlsx" class="file-embed-button wide"><span class="file-embed-button-text">Download</span></a></div><a href="https://readrichtext.substack.com/api/v1/file/da7f3f05-1aba-4178-ba04-dd4d8ce19d6d.xlsx" class="file-embed-button narrow"><span class="file-embed-button-text">Download</span></a></div></div><div data-component-name="FileToDOM" class="file-embed-wrapper"><div class="file-embed-container-reader"><div class="file-embed-container-top"><img src="https://substackcdn.com/image/fetch/$s_!0Cy0!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack.com%2Fimg%2Fattachment_icon.svg" class="file-embed-thumbnail-default"/><div class="file-embed-details"><div class="file-embed-details-h1">Account Ledger Mrrf After Cloud</div><div class="file-embed-details-h2">21.2KB ∙ XLSX file</div></div><a href="https://readrichtext.substack.com/api/v1/file/8448ff1c-13d6-48d1-8c6e-c4dfeef5e392.xlsx" class="file-embed-button wide"><span class="file-embed-button-text">Download</span></a></div><a href="https://readrichtext.substack.com/api/v1/file/8448ff1c-13d6-48d1-8c6e-c4dfeef5e392.xlsx" class="file-embed-button narrow"><span class="file-embed-button-text">Download</span></a></div></div><p></p><div><hr/></div><h3 class="header-anchor-post">Who the system is built for<div class="pencraft pc-display-flex pc-alignItems-center pc-position-absolute pc-reset header-anchor-parent"><div class="pencraft pc-display-contents pc-reset pubTheme-yiXxQA"><div id="§who-the-system-is-built-for" class="pencraft pc-reset header-anchor offset-top"></div><button tabindex="0" type="button" aria-label="Link" data-href="https://readrichtext.substack.com/i/197441967/who-the-system-is-built-for" class="pencraft pc-reset pencraft iconButton-mq_Et5 iconButtonBase-dJGHgN buttonBase-GK1x3M buttonStyle-r7yGCK size_sm-G3LciD priority_secondary-S63h9o"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-link"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg></button></div></div></h3><p>So let's get this straight:</p><p>No board, committee, or anyone else provides oversight of MRRF. Secret encampment meetings. A $2.7 million downtown ask with no scope of work that lists tourism before housing. A consulting model designed for downtown business districts, imported without the infrastructure that makes it work. A Council-mandated spending plan answered with a non-answer. And when a journalist asked the director how the money was being spent, the answer was that it should not be posted publicly. </p><p>Each of these, individually, might be an oversight. Together, they describe a system where the people furthest from the problem have the most control over the solution, and the people closest to it have the least.</p><p><span>It is possible to improve tourism and commerce </span><em>and</em><span> serve the unhoused. Those goals don’t have to conflict. But they conflict when a system unambiguously prioritizing the removal of visible homelessness from downtown corridors is presented as a system for ending homelessness, because the only thing that ends homelessness is decommodified housing, and encampment clearance optimized for business districts is not a housing program. It is a displacement program that may or may not include housing, depending on whether the system behind it has the capacity, the criteria, and the accountability to deliver. Nashville doesn’t.</span></p><p>You might assume Calvin is the bullshitter I described at the top of this piece. Perhaps she fits the bill. But the person I am really describing is Kristin Wilson: someone handpicked by Bloomberg Philanthropies to make cities more business-friendly while “solving street homelessness.” </p><p><span>Wilson’s fingerprints are on this entire architecture, from the Koch contracts to the </span><a href="https://readrichtext.substack.com/p/the-peoples-house-how-nashville-metro">NDP grant that attempted to funnel surveillance technology through a downtown business district</a><span> to the budget that Calvin presented on Wednesday.</span></p><p>And the irony is that the bullshit is not even working on its own terms. The unhoused have gained more public empathy, more political power, and more public support than ever before in modern Nashville, precisely because of what is being done to them. </p><p>The business interests Wilson was installed to serve have not been served. They have been exposed.</p><p>The bullshit is not working. Not for the unhoused, obviously. But increasingly, not for the business interests it was designed to serve. </p><p>How many of you knew who Tom Turner is and what the Nashville Downtown Partnership was one year ago? I did not.</p><p>Expect a companion piece to this on the CBID’s budget coming soon.</p><div><hr/></div><p>This is the pattern I described at the top, and it is not confined to Nashville’s homeless services budget. The catastrophic things happening at the federal level, the gutting of agencies, the mass firings, the contempt for courts and congressional authority, were not conjured from nothing by rogue bands of alt-right operatives. They were teed up by a generation of liberal technocrats who treated government like a business to be optimized, procurement law like a suggestion, and democratic oversight like a bottleneck.</p><p>Wilson did not need Curtis Yarvin to teach her that a city department should report to a single executive with no board oversight, that spending criteria need not be published, that encampment decisions can be made in secret, or that a journalist asking where the money went should be told it “should not be posted publicly.” </p><p>She built that architecture under two mayors, one of whom ran as “truly progressive” and now governs with a Republican chief of staff, an ICE data-pipeline builder setting the city budget, and is thrilled to have Oracle’s $4.5 billion East Bank campus rising on the riverfront.</p><p>Nashville is not a random city. It is increasingly the playground of the billionaire class, in a state whose supermajority has gerrymandered its congressional representation, made camping on public property a felony, and systematically curtailed its capacity for democratic self-governance.</p><p>The neoliberal version of this says “run government like a business.” The neoreactionary version says “run government like a corporation with a CEO-king.” The difference is one of candor, not of structure.</p><p>And when the liberal version fails, when the bullshit implementations of perfectly good ideas produce declining outcomes and eroding trust, the brutal right-wing pendulum swing appears to be “the only alternative.” That is how democracies do not fall to coups. They are handed over, one procurement bypass at a time, by people who believed they were “innovating.”</p><div><hr/></div><p>When meeting with researchers and organizers interested in what is happening in Nashville, I have increasingly been able to tell them what my “beat” is: the intersection between the least and most powerful in our cities. Homelessness, I’ve learned, is precisely that place. </p><p>The most powerful and politically connected, those with business interests in downtown cores and high-rise apartments they want to build and tourism they want to see grow unabated, they consistently run into the people who have been failed by our society, our economy, and our empathy.</p><p>To be able to do what you want with the bodies of the unhoused as efficiently as possible, without being hindered by complications like “what happens to them after you get them off the street,” it takes people who are able to fluently speak the liberal language of being “data-driven,” following “best practices.” </p><p>People who who are able to shield their politically motivated decisions behind “experts”, preferably experts who are not local and are therefore not accountable to having to live in the communities they are being paid to redesign.</p><p>Councilwoman Ellis asked for something she could explain to a group of kids at a bus stop. Here it is: Nashville spent $50 million to reduce homelessness. Homelessness went up. The people in charge said different things to different rooms about why. Sometimes, different things are in the same room. And the system is built so that no one with the power to ask the next question has the information needed to do so.</p><p>The system is not built for the people it is meant to serve. It is built for the people who find those-who-need-housing to be inconvenient, not for the people who need housing. The city would rather throw good money after bad, pouring it directly into the pockets of the landlords who are emptying people onto our streets, than actually invest in the thing that would solve it: decommodified housing.</p><p><span>I don’t think they will do it. And here is why: They will not do it because it doesn’t make people money. It's not that </span><em>they</em><span> won’t make money from it, it's not corruption in that straight forward a way. But actually providing housing as a human right, not making it a commodity that someone can extract vast wealth from, goes against their core beliefs. </span></p><p>Doing something that does not make people money is dangerous to them because it would show that the world they think they live in is a lie. </p><p>At the core of the belief that seems to unite the Far Right and the Centrist Liberals who run Nashville is the conviction that might makes right. The only difference is in its application. </p><p>To the Far Right, power should be exercised through brutal, dominating, violent force. To Centrist Liberals, power is meant to be exerted secretively — through obfuscation of methods, the usurping of norms, and the abstraction of process until the less powerful become the least powerful and the most confused. </p><p>What the Centrist Liberals seem not to realize, or do not care about, is that this is precisely the architecture that has led to the violent takeover of our democracy by the Far Right. </p><p>This is precisely the world that Curtis Yarvin has been calling for — renaming the God Emperor, with power of life and death over all his subjects, in the euphemistic terms of &quot;CEO&quot; of a corporate state. This is, quite literally, the definition of fascism, and Centrist Liberals have been designing its instruments for decades. In Nashville, they have been doing it most of all to precisely the targets who were the first victims of last century's fascists: the unhoused, the disenfranchised, and the unconventional. </p><p>In June 1938, Reinhard Heydrich ordered a nationwide raid that sent 9,500 people labeled &quot;asocial&quot; to Buchenwald, Dachau, and Sachsenhausen — most of them homeless, beggars, welfare recipients, and casual workers; the Nazi regime regarded homeless people, along with those unable to hold a job, as &quot;genetically degenerate&quot; threats to the so-called health of the race.</p><p>I don’t know how to make this clearer: a system that is unaccountable, ungovernable, untransparent, and unambiguously failing at the very thing it’s supposed to do is always dangerous and bad. </p><p><span>But in the current political climate, it is, and I truly do not believe I am exaggerating, the recipe for having people “disappear”, for sex trafficking, for corpses sold for profit, and, if history repeats itself, mass murder. And if that does not concern you, please… just think of the legal liability that might create for Metro Nashville and the businesses associated with the activities downtown. </span><em>Maybe that’ll make you care?</em></p><p><span>Director Calvin is right: the solution to homelessness is housing. She is unquestionably correct. If Nashville actually provided what even she knows is needed (decommodified housing), all of this </span><em>mishegoss</em><span> of paying slumlords, pretending we’re Housing First, millions in consulting contracts to wrest control of the continuum of care from the people who actually do the work, all of it would be shown for what it really is.</span></p><p>Liberal bullshittery.</p><div class="captioned-image-container"><figure><a target="_blank" href="https://substackcdn.com/image/fetch/$s_!rcTG!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F86a95049-3073-470d-a1ec-14f4992a6c6f_1920x1080.png" data-component-name="Image2ToDOM" class="image-link image2 is-viewable-img can-restack"><div class="image2-inset"><picture><source type="image/webp" srcset="https://substackcdn.com/image/fetch/$s_!rcTG!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F86a95049-3073-470d-a1ec-14f4992a6c6f_1920x1080.png 424w, https://substackcdn.com/image/fetch/$s_!rcTG!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F86a95049-3073-470d-a1ec-14f4992a6c6f_1920x1080.png 848w, https://substackcdn.com/image/fetch/$s_!rcTG!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F86a95049-3073-470d-a1ec-14f4992a6c6f_1920x1080.png 1272w, https://substackcdn.com/image/fetch/$s_!rcTG!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F86a95049-3073-470d-a1ec-14f4992a6c6f_1920x1080.png 1456w" sizes="100vw"/><img src="https://substackcdn.com/image/fetch/$s_!rcTG!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F86a95049-3073-470d-a1ec-14f4992a6c6f_1920x1080.png" width="1456" height="819" data-attrs="{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/86a95049-3073-470d-a1ec-14f4992a6c6f_1920x1080.png&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:819,&quot;width&quot;:1456,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:1242144,&quot;alt&quot;:null,&quot;title&quot;:null,&quot;type&quot;:&quot;image/png&quot;,&quot;href&quot;:null,&quot;belowTheFold&quot;:true,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://readrichtext.substack.com/i/197441967?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F86a95049-3073-470d-a1ec-14f4992a6c6f_1920x1080.png&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}" alt srcset="https://substackcdn.com/image/fetch/$s_!rcTG!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F86a95049-3073-470d-a1ec-14f4992a6c6f_1920x1080.png 424w, https://substackcdn.com/image/fetch/$s_!rcTG!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F86a95049-3073-470d-a1ec-14f4992a6c6f_1920x1080.png 848w, https://substackcdn.com/image/fetch/$s_!rcTG!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F86a95049-3073-470d-a1ec-14f4992a6c6f_1920x1080.png 1272w, https://substackcdn.com/image/fetch/$s_!rcTG!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F86a95049-3073-470d-a1ec-14f4992a6c6f_1920x1080.png 1456w" sizes="100vw" loading="lazy" class="sizing-normal"/></picture><div class="image-link-expand"><div class="pencraft pc-display-flex pc-gap-8 pc-reset"><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container restack-image"><svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke-width="1.5" stroke="var(--color-fg-primary)" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><g><path d="M2.53001 7.81595C3.49179 4.73911 6.43281 2.5 9.91173 2.5C13.1684 2.5 15.9537 4.46214 17.0852 7.23684L17.6179 8.67647M17.6179 8.67647L18.5002 4.26471M17.6179 8.67647L13.6473 6.91176M17.4995 12.1841C16.5378 15.2609 13.5967 17.5 10.1178 17.5C6.86118 17.5 4.07589 15.5379 2.94432 12.7632L2.41165 11.3235M2.41165 11.3235L1.5293 15.7353M2.41165 11.3235L6.38224 13.0882"></path></g></svg></button><button tabindex="0" type="button" class="pencraft pc-reset pencraft icon-container view-image"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-maximize2 lucide-maximize-2"><polyline points="15 3 21 3 21 9"></polyline><polyline points=